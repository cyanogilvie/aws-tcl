# pkg-config metadata for aws-tcl.  Pure-Tcl module — no Cflags / Libs
# (nothing to link against). The single useful variable for downstream
# meson / shell consumers is `tcl_tm_path`: the directory that should
# be added to a Tcl interpreter's tcl::tm::path so that
# `package require aws` resolves to the installed module.
#
# Layout assumes the install pattern produced by Tcl extension meson
# builds: the .pc file lands in ${prefix}/lib/pkgconfig and the .tm
# module + per-service tree in ${prefix}/lib/tcl<MAJOR>/site-tcl/.
# Resolving via ${pcfiledir}/.. keeps the file relocatable.

tcl_tm_path=${pcfiledir}/../tcl@TCL_MAJOR@/site-tcl

Name: @PACKAGE_NAME@
Description: AWS service-API client for Tcl, generated from botocore service definitions
URL: https://github.com/cyanogilvie/aws-tcl
Version: @PACKAGE_VERSION@
