	dict get $opts -errorcode
} -cleanup {::test_creds::cleanup} -result {AWS SSO_NO_TOKEN}

test sso-profile-1.4 {legacy form routes through SSO path (token missing)} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
sso_start_url = https://e.awsapps.com/start
sso_region = us-east-1
sso_account_id = 123456789012
sso_role_name = AdminAccess
"
	set ::env(AWS_EC2_METADATA_DISABLED) true
} -body {
	catch {::test_creds::get_creds} msg opts
	dict get $opts -errorcode
} -cleanup {::test_creds::cleanup} -result {AWS SSO_NO_TOKEN}

test sso-profile-1.5 {expired token without refresh token -> clear error} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
sso_session = dev
sso_account_id = 123456789012
sso_role_name = AdminAccess

\[sso-session dev\]
sso_start_url = https://e.awsapps.com/start
sso_region = us-east-1
"
	set tpath [::aws::helpers::_sso_token_cache_path dev]
	::test_creds::write_file $tpath {
		{
			"accessToken":   "OLD",
			"expiresAt":     "2000-01-01T00:00:00Z"
		}
	}
	set ::env(AWS_EC2_METADATA_DISABLED) true
} -body {
	catch {::test_creds::get_creds} msg opts
	list [dict get $opts -errorcode] [string match "*aws sso login*" $msg]
} -cleanup {::test_creds::cleanup} -result {{AWS SSO_TOKEN_EXPIRED} 1}
#>>>

# CA bundle <<<
test ca-bundle-1.1 {env AWS_CA_BUNDLE wins} -setup {::test_creds::setup} -body {
	set ::env(AWS_CA_BUNDLE) /etc/ssl/custom.pem
	::aws::helpers::_ca_bundle
} -cleanup {::test_creds::cleanup} -result /etc/ssl/custom.pem

test ca-bundle-1.2 {profile ca_bundle when no env} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
ca_bundle = /etc/corp-ca.pem
"
} -body {
	::aws::helpers::_ca_bundle
} -cleanup {::test_creds::cleanup} -result /etc/corp-ca.pem

test ca-bundle-1.3 {env beats profile} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
ca_bundle = /etc/profile.pem
"
} -body {
	set ::env(AWS_CA_BUNDLE) /etc/env.pem
	::aws::helpers::_ca_bundle
} -cleanup {::test_creds::cleanup} -result /etc/env.pem

test ca-bundle-1.4 {empty string when unset} -setup {::test_creds::setup} -body {
	::aws::helpers::_ca_bundle
} -cleanup {::test_creds::cleanup} -result {}
#>>>

cleanupTests
return
