if {[lsearch [namespace children] ::tcltest] == -1} {
	package require tcltest
	namespace import ::tcltest::*
}

tcltest::loadTestedCommands
package require aws 2
package require rl_json 0.17
interp alias {} json {} ::rl_json::json

# Tests for the credential/config resolution chain. These exercise the
# helper surface (profile name, file paths, profile reads, static-cred
# resolution) plus the provider chain in get_creds. Live-AWS providers
# (IMDS, AssumeRole, web-identity) are not exercised here — those need
# network / STS mocks that are heavier than warranted for unit tests.

namespace eval ::test_creds {
	variable saved_env		{}
	variable saved_creds	""
	variable saved_retry_mode
	variable saved_max_attempts

	# Env keys that any test in this file might touch.
	variable touched_env {
		HOME AWS_PROFILE AWS_DEFAULT_PROFILE AWS_CONFIG_FILE
		AWS_SHARED_CREDENTIALS_FILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
		AWS_SESSION_TOKEN AWS_REGION AWS_DEFAULT_REGION AWS_ENDPOINT_URL
		AWS_ENDPOINT_URL_S3 AWS_ENDPOINT_URL_DYNAMODB
		AWS_ENDPOINT_URL_TRANSCRIBE_STREAMING AWS_RETRY_MODE
		AWS_MAX_ATTEMPTS AWS_USE_FIPS_ENDPOINT AWS_USE_DUALSTACK_ENDPOINT
		AWS_ROLE_ARN AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_SESSION_NAME
		AWS_CONTAINER_CREDENTIALS_RELATIVE_URI
		AWS_CONTAINER_CREDENTIALS_FULL_URI
		AWS_CONTAINER_AUTHORIZATION_TOKEN
		AWS_EC2_METADATA_DISABLED AWS_CA_BUNDLE
	}

	proc setup {} {
		variable saved_env
		variable saved_creds
		variable saved_retry_mode
		variable saved_max_attempts
		variable touched_env
		global env

		set saved_env {}
		foreach v $touched_env {
			if {[info exists env($v)]} {
				dict set saved_env $v $env($v)
				unset env($v)
			} else {
				dict set saved_env $v __UNSET__
			}
		}
		set saved_retry_mode	[set ::aws::helpers::retry_mode]
		set saved_max_attempts	[set ::aws::helpers::max_attempts]
		set ::aws::helpers::retry_mode		""
		set ::aws::helpers::max_attempts	""

		if {[info exists ::aws::helpers::creds]} {
			set saved_creds $::aws::helpers::creds
			unset ::aws::helpers::creds
		} else {
			set saved_creds __UNSET__
		}

		variable tmpdir	[file join [::tcltest::temporaryDirectory] aws-creds-[pid]-[clock microseconds]]
		file mkdir $tmpdir
		set env(HOME) $tmpdir
	}

	proc cleanup {} {
		variable saved_env
		variable saved_creds
		variable saved_retry_mode
		variable saved_max_attempts
		variable tmpdir
		global env

		file delete -force $tmpdir

		dict for {k v} $saved_env {
			if {$v eq "__UNSET__"} {
				unset -nocomplain env($k)
			} else {
				set env($k) $v
			}
		}
		set ::aws::helpers::retry_mode		$saved_retry_mode
		set ::aws::helpers::max_attempts	$saved_max_attempts

		unset -nocomplain ::aws::helpers::creds
		if {$saved_creds ne "__UNSET__"} {
			set ::aws::helpers::creds $saved_creds
		}
	}

	proc write_file {path content} {
		set dir [file dirname $path]
		if {![file isdirectory $dir]} {file mkdir $dir}
		set fh [open $path w]
		try { puts -nonewline $fh $content } finally { close $fh }
	}

	proc get_creds {} {
		return [::aws::helpers::get_creds]
	}
}

# Profile name resolution <<<
test profile-name-1.1 {default when no env} -setup {::test_creds::setup} -body {
	::aws::helpers::_profile_name
} -cleanup {::test_creds::cleanup} -result default

test profile-name-1.2 {AWS_PROFILE wins} -setup {::test_creds::setup} -body {
	set ::env(AWS_PROFILE) mine
	::aws::helpers::_profile_name
} -cleanup {::test_creds::cleanup} -result mine

test profile-name-1.3 {AWS_DEFAULT_PROFILE is fallback} -setup {::test_creds::setup} -body {
	set ::env(AWS_DEFAULT_PROFILE) fallback
	::aws::helpers::_profile_name
} -cleanup {::test_creds::cleanup} -result fallback

test profile-name-1.4 {AWS_PROFILE takes precedence over AWS_DEFAULT_PROFILE} -setup {::test_creds::setup} -body {
	set ::env(AWS_PROFILE) active
	set ::env(AWS_DEFAULT_PROFILE) fallback
	::aws::helpers::_profile_name
} -cleanup {::test_creds::cleanup} -result active

test profile-name-1.5 {empty AWS_PROFILE falls through to default} -setup {::test_creds::setup} -body {
	set ::env(AWS_PROFILE) ""
	::aws::helpers::_profile_name
} -cleanup {::test_creds::cleanup} -result default
#>>>

# Config file path resolution <<<
test config-path-1.1 {AWS_CONFIG_FILE overrides HOME} -setup {::test_creds::setup} -body {
	set ::env(AWS_CONFIG_FILE) /custom/conf
	::aws::helpers::_config_file_path
} -cleanup {::test_creds::cleanup} -result /custom/conf

test config-path-1.2 {default is HOME/.aws/config} -setup {::test_creds::setup} -body {
	expr {[::aws::helpers::_config_file_path] eq [file join $::test_creds::tmpdir .aws/config]}
} -cleanup {::test_creds::cleanup} -result 1

test creds-path-1.1 {AWS_SHARED_CREDENTIALS_FILE overrides HOME} -setup {::test_creds::setup} -body {
	set ::env(AWS_SHARED_CREDENTIALS_FILE) /custom/creds
	::aws::helpers::_credentials_file_path
} -cleanup {::test_creds::cleanup} -result /custom/creds

test creds-path-1.2 {default is HOME/.aws/credentials} -setup {::test_creds::setup} -body {
	expr {[::aws::helpers::_credentials_file_path] eq [file join $::test_creds::tmpdir .aws/credentials]}
} -cleanup {::test_creds::cleanup} -result 1
#>>>

# Profile key reads <<<
test profile-keys-1.1 {config file default section} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
region = eu-west-1
output = json
"
} -body {
	set d [::aws::helpers::_config_profile_keys default]
	list [dict get $d region] [dict get $d output]
} -cleanup {::test_creds::cleanup} -result {eu-west-1 json}

test profile-keys-1.2 {config file named profile uses "profile NAME" section} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[profile work\]
region = us-west-2
retry_mode = adaptive
"
} -body {
	set d [::aws::helpers::_config_profile_keys work]
	list [dict get $d region] [dict get $d retry_mode]
} -cleanup {::test_creds::cleanup} -result {us-west-2 adaptive}

test profile-keys-1.3 {credentials file uses bare profile name} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/credentials] \
"\[work\]
aws_access_key_id = AK
aws_secret_access_key = SK
"
} -body {
	set d [::aws::helpers::_credentials_profile_keys work]
	list [dict get $d aws_access_key_id] [dict get $d aws_secret_access_key]
} -cleanup {::test_creds::cleanup} -result {AK SK}

test profile-keys-1.4 {_profile_value: credentials file wins over config} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
aws_access_key_id = FROM_CONFIG
"
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/credentials] \
"\[default\]
aws_access_key_id = FROM_CREDS
"
} -body {
	::aws::helpers::_profile_value aws_access_key_id default
} -cleanup {::test_creds::cleanup} -result FROM_CREDS
#>>>

# get_creds resolution <<<
test get-creds-1.1 {env vars win} -setup {::test_creds::setup} -body {
	set ::env(AWS_ACCESS_KEY_ID)		AKID-ENV
	set ::env(AWS_SECRET_ACCESS_KEY)	SK-ENV
	set ::env(AWS_SESSION_TOKEN)		TOK-ENV
	set c [::test_creds::get_creds]
	list \
		[dict get $c access_key] \
		[dict get $c secret] \
		[dict get $c token] \
		[dict get $c source]
} -cleanup {::test_creds::cleanup} -result {AKID-ENV SK-ENV TOK-ENV env}

test get-creds-1.2 {no session token in env is fine} -setup {::test_creds::setup} -body {
	set ::env(AWS_ACCESS_KEY_ID)		AK
	set ::env(AWS_SECRET_ACCESS_KEY)	SK
	set c [::test_creds::get_creds]
	list \
		[dict get $c access_key] \
		[dict get $c secret] \
		[dict exists $c token]
} -cleanup {::test_creds::cleanup} -result {AK SK 0}

test get-creds-1.3 {static creds from credentials file} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/credentials] \
"\[default\]
aws_access_key_id = AKID-FILE
aws_secret_access_key = SK-FILE
aws_session_token = TOK-FILE
"
} -body {
	set c [::test_creds::get_creds]
	list \
		[dict get $c access_key] \
		[dict get $c secret] \
		[dict get $c token] \
		[dict get $c source]
} -cleanup {::test_creds::cleanup} -result {AKID-FILE SK-FILE TOK-FILE profile:default}

test get-creds-1.4 {session token from credentials file — regression} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/credentials] \
"\[default\]
aws_access_key_id = AK
aws_secret_access_key = SK
aws_session_token = TEMP
"
} -body {
	# Prior to the refactor the token was hardcoded to "" here.
	dict get [::test_creds::get_creds] token
} -cleanup {::test_creds::cleanup} -result TEMP

test get-creds-1.5 {named profile via AWS_PROFILE} -setup {
	::test_creds::setup
	set ::env(AWS_PROFILE) work
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/credentials] \
"\[default\]
aws_access_key_id = DEFAULT-AK
aws_secret_access_key = DEFAULT-SK

\[work\]
aws_access_key_id = WORK-AK
aws_secret_access_key = WORK-SK
"
} -body {
	dict get [::test_creds::get_creds] access_key
} -cleanup {::test_creds::cleanup} -result WORK-AK

test get-creds-1.6 {AWS_DEFAULT_PROFILE fallback when AWS_PROFILE unset} -setup {
	::test_creds::setup
	set ::env(AWS_DEFAULT_PROFILE) work
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/credentials] \
"\[work\]
aws_access_key_id = WORK-AK
aws_secret_access_key = WORK-SK
"
} -body {
	dict get [::test_creds::get_creds] access_key
} -cleanup {::test_creds::cleanup} -result WORK-AK

test get-creds-1.7 {AWS_SHARED_CREDENTIALS_FILE override} -setup {
	::test_creds::setup
	set alt [file join $::test_creds::tmpdir alt-creds]
	set ::env(AWS_SHARED_CREDENTIALS_FILE) $alt
	::test_creds::write_file $alt \
"\[default\]
aws_access_key_id = ALT-AK
aws_secret_access_key = ALT-SK
"
} -body {
	dict get [::test_creds::get_creds] access_key
} -cleanup {::test_creds::cleanup} -result ALT-AK

test get-creds-1.8 {nothing anywhere -> NO_CREDENTIALS} -setup {
	::test_creds::setup
	set ::env(AWS_EC2_METADATA_DISABLED) true
} -body {
	catch {::test_creds::get_creds} msg opts
	list [dict get $opts -errorcode] $msg
} -cleanup {::test_creds::cleanup} \
  -result {{AWS NO_CREDENTIALS} {No credentials were supplied or could be found}}

test get-creds-1.10 {profile with mfa_serial raises clear error} -setup {
	::test_creds::setup
	set ::env(AWS_EC2_METADATA_DISABLED) true
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
role_arn = arn:aws:iam::123456789012:role/R
source_profile = src
mfa_serial = arn:aws:iam::123456789012:mfa/u
"
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/credentials] \
"\[src\]
aws_access_key_id = AK
aws_secret_access_key = SK
"
} -body {
	catch {::test_creds::get_creds} msg opts
	list [dict get $opts -errorcode] [string match "*MFA*" $msg]
} -cleanup {::test_creds::cleanup} -result {{AWS UNSUPPORTED} 1}

test get-creds-1.11 {credential_process happy path} -setup {
	::test_creds::setup
	set ::env(AWS_EC2_METADATA_DISABLED) true
	set script [file join $::test_creds::tmpdir fakecreds.sh]
	::test_creds::write_file $script "#!/bin/sh
cat <<EOF
{\"Version\":1,\"AccessKeyId\":\"CPAK\",\"SecretAccessKey\":\"CPSK\",\"SessionToken\":\"CPTOK\",\"Expiration\":\"2099-01-01T00:00:00Z\"}
EOF
"
	file attributes $script -permissions rwxr-xr-x
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
credential_process = $script
"
} -body {
	set c [::test_creds::get_creds]
	list \
		[dict get $c access_key] \
		[dict get $c secret] \
		[dict get $c token] \
		[dict get $c source] \
		[expr {[dict exists $c expires] ? "has_expires" : "no_expires"}]
} -cleanup {::test_creds::cleanup} -result {CPAK CPSK CPTOK credential_process has_expires}

test get-creds-1.12 {credential_process bad json -> clear error} -setup {
	::test_creds::setup
	set ::env(AWS_EC2_METADATA_DISABLED) true
	set script [file join $::test_creds::tmpdir fakecreds.sh]
	::test_creds::write_file $script "#!/bin/sh
echo 'not json'
"
	file attributes $script -permissions rwxr-xr-x
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
credential_process = $script
"
} -body {
	catch {::test_creds::get_creds} msg opts
	dict get $opts -errorcode
} -cleanup {::test_creds::cleanup} -result {AWS CREDENTIAL_PROCESS}

test get-creds-1.13 {set_creds overrides chain} -setup {::test_creds::setup} -body {
	::aws::helpers::set_creds -access_key MY-AK -secret MY-SK -token MY-TOK
	set c [::test_creds::get_creds]
	list [dict get $c access_key] [dict get $c secret] [dict get $c token]
} -cleanup {
	::test_creds::cleanup
} -result {MY-AK MY-SK MY-TOK}
#>>>

# Endpoint URL override <<<
test endpoint-override-1.1 {AWS_ENDPOINT_URL applies} -setup {
	::test_creds::setup
} -body {
	set ::env(AWS_ENDPOINT_URL) http://localhost:4566
	::aws::helpers::_endpoint_url_override s3
} -cleanup {::test_creds::cleanup} -result http://localhost:4566

test endpoint-override-1.2 {per-service env beats global} -setup {
	::test_creds::setup
} -body {
	set ::env(AWS_ENDPOINT_URL)		http://generic
	set ::env(AWS_ENDPOINT_URL_S3)	http://s3-specific
	::aws::helpers::_endpoint_url_override s3
} -cleanup {::test_creds::cleanup} -result http://s3-specific

test endpoint-override-1.3 {service name is upper-cased + hyphens converted} -setup {
	::test_creds::setup
} -body {
	set ::env(AWS_ENDPOINT_URL_TRANSCRIBE_STREAMING) http://x
	::aws::helpers::_endpoint_url_override transcribe-streaming
} -cleanup {::test_creds::cleanup} -result http://x

test endpoint-override-1.4 {profile endpoint_url applies} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
endpoint_url = http://from-profile
"
} -body {
	::aws::helpers::_endpoint_url_override s3
} -cleanup {::test_creds::cleanup} -result http://from-profile

test endpoint-override-1.5 {env beats profile} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
endpoint_url = http://from-profile
"
} -body {
	set ::env(AWS_ENDPOINT_URL) http://from-env
	::aws::helpers::_endpoint_url_override s3
} -cleanup {::test_creds::cleanup} -result http://from-env

test endpoint-override-1.6 {no override when nothing set} -setup {::test_creds::setup} -body {
	::aws::helpers::_endpoint_url_override s3
} -cleanup {::test_creds::cleanup} -result {}

test endpoint-apply-1.1 {_apply_endpoint_override mutates hostname/protocols} -setup {
	::test_creds::setup
} -body {
	set ::env(AWS_ENDPOINT_URL) http://localhost:4566
	set ei [dict create \
		hostname		s3.amazonaws.com \
		protocols		https \
		region			us-east-1 \
		credentialScope	{region us-east-1} \
		sslCommonName	s3.amazonaws.com]
	::aws::helpers::_apply_endpoint_override ei s3
	list \
		[dict get $ei hostname] \
		[dict get $ei protocols] \
		[dict exists $ei sslCommonName]
} -cleanup {::test_creds::cleanup} -result {localhost:4566 http 0}

test endpoint-apply-1.2 {_apply_endpoint_override without port} -setup {
	::test_creds::setup
} -body {
	set ::env(AWS_ENDPOINT_URL) https://custom.example.com
	set ei [dict create hostname s3.amazonaws.com protocols https]
	::aws::helpers::_apply_endpoint_override ei s3
	list [dict get $ei hostname] [dict get $ei protocols]
} -cleanup {::test_creds::cleanup} -result {custom.example.com https}
#>>>

# Retry config <<<
test retry-config-1.1 {env AWS_RETRY_MODE wins} -setup {::test_creds::setup} -body {
	set ::env(AWS_RETRY_MODE) adaptive
	::aws::helpers::_resolve_retry_config
	set ::aws::helpers::retry_mode
} -cleanup {::test_creds::cleanup} -result adaptive

test retry-config-1.2 {profile retry_mode when no env} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
retry_mode = adaptive
max_attempts = 7
"
} -body {
	::aws::helpers::_resolve_retry_config
	list $::aws::helpers::retry_mode $::aws::helpers::max_attempts
} -cleanup {::test_creds::cleanup} -result {adaptive 7}

test retry-config-1.3 {defaults when nothing set} -setup {::test_creds::setup} -body {
	::aws::helpers::_resolve_retry_config
	list $::aws::helpers::retry_mode $::aws::helpers::max_attempts
} -cleanup {::test_creds::cleanup} -result {standard 3}
#>>>

# FIPS / Dualstack <<<
test fips-1.1 {env AWS_USE_FIPS_ENDPOINT=true} -setup {::test_creds::setup} -body {
	set ::env(AWS_USE_FIPS_ENDPOINT) true
	::aws::helpers::_config_bool USE_FIPS_ENDPOINT 0
} -cleanup {::test_creds::cleanup} -result 1

test fips-1.2 {profile use_fips_endpoint=true} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
use_fips_endpoint = true
"
} -body {
	::aws::helpers::_config_bool USE_FIPS_ENDPOINT 0
} -cleanup {::test_creds::cleanup} -result 1

test fips-1.3 {unset -> default} -setup {::test_creds::setup} -body {
	::aws::helpers::_config_bool USE_FIPS_ENDPOINT 0
} -cleanup {::test_creds::cleanup} -result 0
#>>>

# SSO: token cache file location <<<
test sso-path-1.1 {modern form hashes the session name} -setup {::test_creds::setup} -body {
	# sha1("dev") = 34c6fceca75e456f25e7e99531e2425c6c1de443
	file tail [::aws::helpers::_sso_token_cache_path dev]
} -cleanup {::test_creds::cleanup} -result 34c6fceca75e456f25e7e99531e2425c6c1de443.json

test sso-path-1.2 {legacy form hashes the start URL} -setup {::test_creds::setup} -body {
	# sha1("https://example.awsapps.com/start") = e8be5486177c5b5392bd9aa76563515b29358e6e
	file tail [::aws::helpers::_sso_token_cache_path https://example.awsapps.com/start]
} -cleanup {::test_creds::cleanup} -result e8be5486177c5b5392bd9aa76563515b29358e6e.json
#>>>

# SSO: token file parsing <<<
test sso-token-1.1 {load token dict} -setup {
	::test_creds::setup
	set tpath [::aws::helpers::_sso_token_cache_path dev]
	::test_creds::write_file $tpath {
		{
			"accessToken":   "AT-123",
			"expiresAt":     "2099-01-01T12:00:00Z",
			"refreshToken":  "RT-456",
			"clientId":      "cid",
			"clientSecret":  "csec",
			"region":        "us-east-1",
			"startUrl":      "https://example.awsapps.com/start"
		}
	}
} -body {
	set t [::aws::helpers::_sso_load_token $tpath https://example.awsapps.com/start dev]
	list \
		[dict get $t accessToken] \
		[dict get $t refreshToken] \
		[dict get $t clientId] \
		[expr {[dict get $t expires_at] > [clock seconds]}]
} -cleanup {::test_creds::cleanup} -result {AT-123 RT-456 cid 1}

test sso-token-1.2 {missing cache file -> SSO_NO_TOKEN} -setup {::test_creds::setup} -body {
	catch {::aws::helpers::_sso_load_token /nonexistent/tok.json x y} msg opts
	dict get $opts -errorcode
} -cleanup {::test_creds::cleanup} -result {AWS SSO_NO_TOKEN}

test sso-token-1.3 {cache missing accessToken -> SSO_TOKEN_INVALID} -setup {
	::test_creds::setup
	set tpath [::aws::helpers::_sso_token_cache_path dev]
	::test_creds::write_file $tpath {{"expiresAt":"2099-01-01T12:00:00Z"}}
} -body {
	catch {::aws::helpers::_sso_load_token $tpath https://e.awsapps.com/start dev} msg opts
	dict get $opts -errorcode
} -cleanup {::test_creds::cleanup} -result {AWS SSO_TOKEN_INVALID}
#>>>

# SSO: write-back preserves fields <<<
test sso-writeback-1.1 {write and reload round-trip} -setup {
	::test_creds::setup
	set tpath [file join $::test_creds::tmpdir .aws/sso/cache/tok.json]
	set token [dict create \
		accessToken		NEW-AT \
		expires_at		[expr {[clock seconds] + 3600}] \
		refreshToken	NEW-RT \
		clientId		CID \
		clientSecret	CSEC \
		region			us-east-1 \
		startUrl		https://e.awsapps.com/start]
} -body {
	::aws::helpers::_sso_write_token_cache $tpath $token
	set t2 [::aws::helpers::_sso_load_token $tpath https://e.awsapps.com/start dev]
	list \
		[dict get $t2 accessToken] \
		[dict get $t2 refreshToken] \
		[dict get $t2 clientId] \
		[dict get $t2 clientSecret] \
		[dict get $t2 region] \
		[dict get $t2 startUrl]
} -cleanup {::test_creds::cleanup} \
  -result {NEW-AT NEW-RT CID CSEC us-east-1 https://e.awsapps.com/start}

test sso-writeback-1.2 {cache file has 0600 mode} -setup {
	::test_creds::setup
	set tpath [file join $::test_creds::tmpdir .aws/sso/cache/tok.json]
	set token [dict create \
		accessToken AT \
		expires_at [expr {[clock seconds] + 3600}]]
	::aws::helpers::_sso_write_token_cache $tpath $token
} -body {
	file attributes $tpath -permissions
} -cleanup {::test_creds::cleanup} -match glob -result *600
#>>>

# SSO: profile validation <<<
test sso-profile-1.1 {modern form missing account id -> clear error} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
sso_session = dev
sso_role_name = R

\[sso-session dev\]
sso_start_url = https://e.awsapps.com/start
sso_region = us-east-1
"
	set ::env(AWS_EC2_METADATA_DISABLED) true
} -body {
	catch {::test_creds::get_creds} msg opts
	list [dict get $opts -errorcode] [string match "*sso_account_id*" $msg]
} -cleanup {::test_creds::cleanup} -result {{AWS PROFILE_INVALID} 1}

test sso-profile-1.2 {modern form missing sso-session section -> clear error} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
sso_session = dev
sso_account_id = 1
sso_role_name = R
"
	set ::env(AWS_EC2_METADATA_DISABLED) true
} -body {
	catch {::test_creds::get_creds} msg opts
	list [dict get $opts -errorcode] [string match "*\[sso-session dev\]*" $msg]
} -cleanup {::test_creds::cleanup} -result {{AWS PROFILE_INVALID} 1}

test sso-profile-1.3 {modern form routes through SSO path (token missing)} -setup {
	::test_creds::setup
	::test_creds::write_file [file join $::test_creds::tmpdir .aws/config] \
"\[default\]
sso_session = dev
sso_account_id = 123456789012
sso_role_name = AdminAccess

\[sso-session dev\]
