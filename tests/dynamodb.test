source [file join [file dirname [file normalize [info script]]] common.tcl]

test dynamodb-list_tables-1.1 {no params} -constraints aws_creds -body { #<<<
	json exists [aws dynamodb list_tables] TableNames
} -result 1
#>>>
test dynamodb-list_tables-1.2 {limit 10} -constraints aws_creds -body { #<<<
	json exists [aws dynamodb list_tables -limit 10] TableNames
} -result 1
#>>>

# cleanup
::tcltest::cleanupTests
return

