# -page alias <<<
test paginate-page-4.1 {-page sets a fresh value once per page} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1},{"id":2}],"NextMarker":"p2","Name":"page-one"}} \
		{{"Widgets":[{"id":3}],"Name":"page-two"}} \
	]
	set page_names	{}
} -body {
	aws foreach w -page page fake list_widgets {
		if {[info exists page]} {
			lappend page_names [json get $page Name]
			unset page
		}
	}
	set page_names
} -cleanup {unset -nocomplain w page page_names} -result {page-one page-two}
#>>>
