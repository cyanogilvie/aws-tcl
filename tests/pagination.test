# Compound tokens (S3 / Route53 style) <<<
test paginate-compound-7.1 {parallel input/output token arrays thread through} -setup { #<<<
	reset_fake_service
	register_fake_op ListObjectVersions {
		input_tokens		{KeyMarker VersionIdMarker}
		output_tokens		{NextKeyMarker NextVersionIdMarker}
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{ObjectVersion {Versions}}}
	} [list \
		{{"Versions":[{"VersionId":"v1"}],"NextKeyMarker":"k2","NextVersionIdMarker":"v2"}} \
		{{"Versions":[{"VersionId":"v3"}]}} \
	]
} -body {
	aws foreach w fake list_object_versions {}
	# Second call should contain both token args forwarded.
	set c1 [lindex $::aws::fake::_calls 1]
	list [lsearch -exact $c1 -key_marker] [lsearch -exact $c1 -version_id_marker]
} -cleanup {unset -nocomplain w c1} -match regexp -result {^[1-9][0-9]* [1-9][0-9]*$}
#>>>
# Compound tokens >>>

