# Integration tests — live AWS, gated by the fixture stack <<<
tcltest::testConstraint aws_creds [try { #<<<
	aws::helpers::get_creds
	return -level 0 true
} trap {AWS NO_CREDENTIALS} {} {
	return -level 0 false
} on error {} {
	return -level 0 false
}]
#>>>

source [file join [file dirname [info script]] fixtures.tcl]

tcltest::testConstraint aws_tcl_fixtures [expr { #<<<
	[tcltest::testConstraint aws_creds] && [try {
		fixture_stack_ready
	} on error {} {return -level 0 false}]
}]
#>>>

# The fixture stack deploys exactly 12 policies, 12 parameters, 3 log groups,
# and (after `make seed-fixtures`) 12 S3 objects. Tests here assert those
# exact counts and against the stack's output-provided prefixes.

test paginate-live-iam-10.1 {exact-count pagination against fixture IAM policies} -constraints aws_tcl_fixtures -setup { #<<<
	set prefix	[fixture_stack_output PolicyPrefix]
	set region	[fixture_stack_region]
} -body {
	set names	{}
	aws foreach p -page_size 5 iam list_policies -region $region -scope Local {
		set name	[json get $p PolicyName]
		if {[string match ${prefix}* $name]} {lappend names $name}
	}
	# 12 fixture policies named <prefix>01..<prefix>12
	list [llength $names] [lindex [lsort $names] 0] [lindex [lsort $names] end]
} -cleanup {unset -nocomplain p name names prefix region} -match glob -result {12 *-policy-01 *-policy-12}
#>>>
test paginate-live-ssm-10.2 {exact-count pagination of fixture SSM parameters} -constraints aws_tcl_fixtures -setup { #<<<
	set prefix	[fixture_stack_output ParamPrefix]
	set region	[fixture_stack_region]
} -body {
	set names	{}
	# SSM is a json-protocol service — complex input values like
	# -parameter_filters are JSON fragments, not Tcl lists.
	aws foreach p -page_size 5 ssm describe_parameters \
			-region $region \
			-parameter_filters [json template {
				[{"Key":"Name","Option":"BeginsWith","Values":["~S:prefix"]}]
			} [list prefix $prefix]] \
	{
		lappend names [json get $p Name]
	}
	llength $names
} -cleanup {unset -nocomplain p names prefix region} -result 12
#>>>
test paginate-live-logs-10.3 {exact-count pagination of fixture log groups with page_size 1} -constraints aws_tcl_fixtures -setup { #<<<
	set prefix	[fixture_stack_output LogGroupPrefix]
	set region	[fixture_stack_region]
} -body {
	set names	{}
	aws foreach g -page_size 1 logs describe_log_groups \
			-region $region \
			-log_group_name_prefix $prefix \
	{
		lappend names [json get $g logGroupName]
	}
	llength $names
} -cleanup {unset -nocomplain g names prefix region} -result 3
#>>>
test paginate-live-s3-flat-10.4 {flat s3 list_objects_v2 — all seeded keys in order} -constraints aws_tcl_fixtures -setup { #<<<
	set bucket	[fixture_stack_output BucketName]
	set region	[fixture_stack_region]
} -body {
	set keys	{}
	aws foreach obj -type Object -page_size 5 s3 list_objects_V2 \
			-region $region \
			-bucket $bucket \
	{
		lappend keys [json get $obj Key]
	}
	llength $keys
} -cleanup {unset -nocomplain obj keys bucket region} -result 12
#>>>
test paginate-live-s3-multi-10.5 {s3 list_objects_v2 multi-container splits Objects and CommonPrefixes} -constraints aws_tcl_fixtures -setup { #<<<
	set bucket	[fixture_stack_output BucketName]
	set region	[fixture_stack_region]
} -body {
	set objects		{}
	set prefixes	{}
	aws foreach item -itemtype t s3 list_objects_V2 \
			-region $region \
			-bucket $bucket \
			-delimiter / \
	{
		switch -- $t {
			Object			{lappend objects [json get $item Key]}
			CommonPrefix	{lappend prefixes [json get $item Prefix]}
			default			{error "unexpected itemtype $t"}
		}
	}
	# Root-level: readme.txt is the only Object at the top; files/, zone-a/ and
	# zone-b/ are the three CommonPrefixes.
	list [lsort $objects] [lsort $prefixes]
} -cleanup {unset -nocomplain item t objects prefixes bucket region} \
  -result {readme.txt {files/ zone-a/ zone-b/}}
#>>>
test paginate-live-s3-signing-10.6 {sigv4 signing on keys with spaces, reserved chars, UTF-8} -constraints aws_tcl_fixtures -setup { #<<<
	# head_object exercises the full sigv4 path for each key. If any of these
	# returns a signature-mismatch or the key isn't findable, it'll throw.
	set bucket	[fixture_stack_output BucketName]
	set region	[fixture_stack_region]
	set tricky	{
		"files/with space.txt"
		"files/unicode-é-✓.txt"
		"files/reserved+=&?#.txt"
		"files/parens-(test).txt"
		"files/brackets-\[test\].txt"
		"files/tilde-~test.txt"
	}
} -body {
	foreach key $tricky {
		aws s3 head_object -region $region -bucket $bucket -key $key
	}
	expr {[llength $tricky] == 6}
} -cleanup {unset -nocomplain key tricky bucket region} -result 1
#>>>

# Legacy (Ruby-Lane only) — kept so the existing gated test still runs when
# deploying the fixture stack isn't an option. Skipped otherwise.
tcltest::testConstraint rl_aws_account [expr { #<<<
	[tcltest::testConstraint aws_creds] &&
	[try {
		set aliases	[json get [aws iam list_account_aliases] AccountAliases]
		expr {"rubylane" in $aliases}
	} on error {} {
		return -level 0 false
	}]
}]
#>>>
test paginate-live-cloudformation-11.1 {live cloudformation list_stacks iterates stacks} -constraints rl_aws_account -body { #<<<
	# Rubylane has many stacks; fixture account only has our one fixture stack,
	# so this test can't deterministically force >1 page. Left gated on
	# rl_aws_account for the original regression check.
	set names	{}
	aws foreach s cloudformation list_stacks -region us-east-1 {
		lappend names [json get $s StackName]
		if {[llength $names] >= 3} break
	}
	expr {[llength $names] >= 3}
} -cleanup {unset -nocomplain s names} -result 1
#>>>
# Integration tests >>>

::tcltest::cleanupTests
return

