test paginate-page_size-5.2 {-page_size with no limit_key errors cleanly} -setup { #<<<
	reset_fake_service
	register_fake_op DescribeThing {
		input_tokens		NextToken
		output_tokens		NextToken
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Thing {Things}}}
	} [list {{"Things":[]}}]
} -body {
	aws foreach w -page_size 25 fake describe_thing {}
} -cleanup {unset -nocomplain w} \
  -returnCodes error -errorCode {AWS FOREACH NO_LIMIT_KEY} \
