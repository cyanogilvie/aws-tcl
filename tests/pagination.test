# Tests for aws::foreach and aws::lmap.
#
# Unit tests stand up a fake service namespace with canned paginator metadata
# and a canned page sequence; no live AWS required. Integration tests gated by
# aws_creds / rl_aws_account verify end-to-end behavior against real services.

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*
}

tcltest::loadTestedCommands
package require aws 2
package require rl_json 0.17
package require rltest
interp alias {} json {} ::rl_json::json

# Fake-service harness <<<
# Each test sets: ::aws::fake::paginators (dict op->meta) and
# ::aws::fake::_pages($op) (list of JSON pages). Each call to an op returns the
# next page and advances the index.
namespace eval ::aws::fake {
	namespace export *
	namespace ensemble create -prefixes no
	namespace path {::rl_json ::aws::helpers}
	variable paginators	{}
	variable _pages
	variable _idx
	variable _calls		{}

	proc _serve {op args} {
		variable _pages
		variable _idx
		variable _calls
		lappend _calls [list $op {*}$args]
		set i	[expr {[info exists _idx($op)] ? $_idx($op) : 0}]
		set pages	$_pages($op)
		if {$i >= [llength $pages]} {
			set p	[lindex $pages end]
		} else {
			set p	[lindex $pages $i]
			incr _idx($op)
		}
		return $p
	}
}
package provide aws::fake 2.0a20

proc reset_fake_service {} {
	namespace eval ::aws::fake {
		variable paginators	{}
		variable _pages
		variable _idx
		variable _calls		{}
		array unset _pages
		array unset _idx
		# Clear any op procs added by previous tests
		foreach p [info procs ::aws::fake::*] {
			if {[namespace tail $p] ni {_serve}} {rename $p ""}
		}
	}
}

proc register_fake_op {op pmeta pages} {
	namespace eval ::aws::fake [list variable paginators]
	namespace eval ::aws::fake [list dict set paginators $op $pmeta]
	namespace eval ::aws::fake [list variable _pages]
	set ::aws::fake::_pages([::aws::from_camel $op]) $pages
	# Define an op proc routed through _serve.
	set snake [::aws::from_camel $op]
	namespace eval ::aws::fake [list proc $snake args "_serve $snake {*}\$args"]
}
# Fake-service harness >>>

# Simple single-container, single-token pagination <<<
test paginate-simple-1.1 {iterates all items across multiple pages} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			MaxItems
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1},{"id":2}],"NextMarker":"aaa"}} \
		{{"Widgets":[{"id":3},{"id":4}],"NextMarker":"bbb"}} \
		{{"Widgets":[{"id":5}]}} \
	]
	set ids	{}
} -body {
	aws foreach w fake list_widgets {
		lappend ids [json get $w id]
	}
	set ids
} -cleanup {unset -nocomplain w ids} -result {1 2 3 4 5}
#>>>
test paginate-simple-1.2 {continuation token is threaded through calls} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1}],"NextMarker":"p2"}} \
		{{"Widgets":[{"id":2}],"NextMarker":"p3"}} \
		{{"Widgets":[{"id":3}]}} \
	]
} -body {
	aws foreach w fake list_widgets {}
	lmap c $::aws::fake::_calls {lsearch -exact $c -marker}
} -cleanup {unset -nocomplain w c} -result {-1 1 1}
#>>>
test paginate-simple-1.3 {terminates on empty output_token} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1}],"NextMarker":""}} \
		{{"Widgets":[{"id":99}]}} \
	]
	set ids	{}
} -body {
	aws foreach w fake list_widgets {lappend ids [json get $w id]}
	set ids
} -cleanup {unset -nocomplain w ids} -result 1
#>>>
# Simple single-container, single-token pagination >>>

# Return-code handling <<<
test paginate-break-2.1 {break stops iteration and returns empty} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1},{"id":2},{"id":3}],"NextMarker":"p2"}} \
		{{"Widgets":[{"id":4}]}} \
	]
	set ids	{}
} -body {
	aws foreach w fake list_widgets {
		lappend ids [json get $w id]
		if {[json get $w id] == 2} break
	}
	list $ids [llength $::aws::fake::_calls]
} -cleanup {unset -nocomplain w ids} -result {{1 2} 1}
#>>>
test paginate-continue-2.2 {continue skips item and keeps going} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1},{"id":2},{"id":3}]}} \
	]
	set ids	{}
} -body {
	aws foreach w fake list_widgets {
		set id [json get $w id]
		if {$id == 2} continue
		lappend ids $id
	}
	set ids
} -cleanup {unset -nocomplain w id ids} -result {1 3}
#>>>
test paginate-return-2.3 {return in body exits caller's proc} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1},{"id":2},{"id":3}]}} \
	]
	proc ::test_caller {} {
		aws foreach w fake list_widgets {
			if {[json get $w id] == 2} {return "done-at-2"}
		}
		return "walked-through"
	}
} -body {
	::test_caller
} -cleanup {unset -nocomplain w; rename ::test_caller ""} -result done-at-2
#>>>
test paginate-error-2.4 {error in body propagates with errorCode intact} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list {{"Widgets":[{"id":1}]}}]
} -body {
	aws foreach w fake list_widgets {
		throw {TEST SENTINEL} "body-raised"
	}
} -cleanup {unset -nocomplain w} -returnCodes error -errorCode {TEST SENTINEL} -result body-raised
#>>>
test paginate-next_page-2.5 {NEXT_PAGE throw jumps to next page} -setup { #<<<
	reset_fake_service
	register_fake_op ListWidgets {
		input_tokens		Marker
		output_tokens		NextMarker
		limit_key			{}
		more_results		{}
		non_aggregate_keys	{}
		item_containers		{{Widget {Widgets}}}
	} [list \
		{{"Widgets":[{"id":1},{"id":2},{"id":3}],"NextMarker":"p2"}} \
		{{"Widgets":[{"id":10},{"id":11}]}} \
	]
	set ids	{}
} -body {
	aws foreach w fake list_widgets {
		set id [json get $w id]
		lappend ids $id
		if {$id == 1} {throw {AWS FOREACH NEXT_PAGE} {}}
	}
	set ids
} -cleanup {unset -nocomplain w id ids} -result {1 10 11}
#>>>
