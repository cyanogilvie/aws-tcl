# Multi-container handling <<<
set multi_op_meta {
	input_tokens		Marker
	output_tokens		NextMarker
	limit_key			{}
	more_results		{}
	non_aggregate_keys	{}
	item_containers		{{Object {Contents}} {CommonPrefix {CommonPrefixes}}}
}
set multi_op_pages [list \
	{{"Contents":[{"Key":"a"},{"Key":"b"}],"CommonPrefixes":[{"Prefix":"sub/"}]}} \
]

test paginate-multi-6.1 {no disambiguation → TYPE_REQUIRED} -setup { #<<<
	reset_fake_service
	register_fake_op ListObjectsV2 $multi_op_meta $multi_op_pages
} -body {
	aws foreach w fake list_objects_V2 {}
} -cleanup {unset -nocomplain w} \
  -returnCodes error -errorCode {AWS FOREACH TYPE_REQUIRED} \
  -match glob -result {*multiple item containers*}
