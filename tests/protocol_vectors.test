# Protocol-vector driven tests.
#
# Drives the botocore protocol test suite at botocore/tests/unit/protocols/{input,output}/*.json
# against our compilation pipeline. Each top-level entry in those files is a
# synthetic service description (shapes + operation) with a list of cases;
# each case has input params and an expected serialized HTTP request (for
# input tests) or canned HTTP response and expected parsed result (output
# tests).
#
# Rather than driving the full build / load / stub-rl_http / sign / send loop,
# we extract the compilation artefacts (query_map, template_obj) from
# compile_input directly and reassemble the request the same way the runtime
# does, skipping the signing and network layers. That is enough to validate
# serialization is correct byte-for-byte against the reference vectors.

tcltest::loadTestedCommands
package require aws 2
package require rl_json 0.17
package require reuri
package require tdom
if {[llength [info commands json]] == 0} {namespace import rl_json::*}

# Reuse the build's per-op code generator (compile_op) + shape helpers so the
# harness drives real ops rather than reimplementing serialization. build.tcl
# skips re-sourcing aws.tcl when the package is already loaded.
source [file join [file dirname [file normalize [info script]]] .. build.tcl]
package require rltest

# ------------------------------------------------------------------
# Helpers

# Apply the URL-encoding that reuri awssig does, for comparison against reference bodies that are pre-encoded.
#proc query_encode s {reuri encode awssig $s}

proc synth_service {entry} { #<<<
	# Given a test-file top-level entry (shapes + metadata + cases), build a
	# dummy "service_def" dict that compile_input understands.
	set metadata	[json extract $entry metadata]
	# compile_input uses {service_name,service_name_orig,protocol}.
	set sd	{{}}
	json set sd metadata $metadata
	json set sd metadata service_name		[json string testsvc]
	json set sd metadata service_name_orig	[json string testsvc]
	json set sd shapes		[json extract $entry shapes]
	return $sd
}

#>>>
proc compile_case {entry case} { #<<<
	# Run compile_input for one case's given op and return {params_spec query_map
	# template_obj transforms body}.
	set sd			[synth_service $entry]
	set protocol	[json get $sd metadata protocol]
	set given		[json extract $case given]
	set shape_name	[if {[json exists $given input shape]} {json get $given input shape}]

	# match the defaults compile_input starts with
	set params {}; set cxparams {}; set copy_to_cx {}; set cx_suppress {}
	set uri_map {}; set query_map {}; set header_map {}; set payload {}
	set builtins {}; set transforms {}

	if {$shape_name eq ""} {
		return [dict create \
			params_spec	$params \
			query_map	$query_map \
			uri_map		{} \
			header_map	{} \
			template_obj	{} \
			transforms	$transforms \
			body		{} \
			payload_type	{} \
			protocol	$protocol]
	}
	set t [aws::build::compile_input \
		-protocol			$protocol \
		-params				params \
		-cxparams			cxparams \
		-copy_to_cx			copy_to_cx \
		-cx_suppress		cx_suppress \
		-uri_map			uri_map \
		-query_map			query_map \
		-header_map			header_map \
		-payload			payload \
		-shapes				[json extract $sd shapes] \
		-shape				$shape_name \
		-endpoint_params	{{}} \
		-builtins			builtins \
		-transforms			transforms]

	# If there's a payload member, find its shape type. We need this to decide
	# whether the body is raw bytes (string/blob) or JSON (document/structure).
	set payload_type	""
	if {$payload ne "" && [json exists $sd shapes $shape_name payload]} {
		set pname	[json get $sd shapes $shape_name payload]
		set pshape	[json get $sd shapes $shape_name members $pname shape]
		set payload_type	[json get $sd shapes $pshape type]
		# Document types look like structures but have the "document" trait.
		if {$payload_type eq "structure" && [json get -default false $sd shapes $pshape document]} {
			set payload_type	document
		}
	}

	return [dict create \
		params_spec	$params \
		query_map	$query_map \
		uri_map		$uri_map \
		header_map	$header_map \
		template_obj	$t \
		transforms	$transforms \
		body		$payload \
		payload_type	$payload_type \
		protocol	$protocol]
}
#>>>
proc assemble_query_body {compiled op apiVersion param_dict} { #<<<
	# Simulate what the operation proc would do at runtime for query/ec2: assemble
	# the URL-encoded body. Returns the body string. param_dict is a Tcl dict
	# keyed by the model's member (camel) name, e.g. {ListArg {a b c}}.
	#
	# Map each test param to its arg_name via aws::from_camel, then look up
	# the query_map entry by arg. Queue pairs into $q and flatten each.
	set by_arg	{}
	foreach {name arg spec} [dict get $compiled query_map] {
		dict set by_arg $arg [list $name $spec]
	}
	set q {}
	lappend q Action $op
	lappend q Version $apiVersion
	dict for {camel val} $param_dict {
		set arg	[aws::from_camel $camel]
		if {![dict exists $by_arg $arg]} continue
		lassign [dict get $by_arg $arg] name spec
		aws::_flatten_query_param q $name $val $spec
	}
	set body [join [lmap {k v} $q {format %s=%s $k $v}] &]
	return $body
}

#>>>
proc assemble_json_body {compiled param_json} { #<<<
	# For json/rest-json: apply the template with params-as-snake_case, then
	# strip null leaves (mirrors what _service_req does at runtime).
	# param_json is a JSON object (not a Tcl dict) since it comes straight from
	# the test vector.
	set t	[dict get $compiled template_obj]
	# Walk the template to learn the substitution kind per arg (~S, ~N, ~B,
	# ~J). Composites (object/array values) always need their JSON form so
	# rewriters and ~J: substitutions see real JSON; scalar substitutions
	# (~S/~N/~B) want the raw Tcl value.
	set sub_kinds	[template_sub_kinds $t]
	# rewrite transforms take a JSON fragment in (and produce one). The
	# scalar transforms (blob/float/ts_*) take a raw Tcl value. Record which
	# kind each transformed var uses so the harness picks the right form.
	set tx_kind	{}
	foreach tfm [dict get $compiled transforms] {
		dict set tx_kind [lindex $tfm 1] [lindex $tfm 0]
	}
	set args	{}
	json foreach {camel v} $param_json {
		set arg	[aws::from_camel $camel]
		if {[json type $v] eq "null"} continue
		set jtype	[json type $v]
		set kind	[if {[dict exists $sub_kinds _tx_$arg]} {
			dict get $sub_kinds _tx_$arg
		} elseif {[dict exists $sub_kinds $arg]} {
			dict get $sub_kinds $arg
		}]
		set wants_json	[expr {
			[dict exists $tx_kind $arg] && [dict get $tx_kind $arg] eq "rewrite" ||
			![dict exists $tx_kind $arg] && ($kind eq "J" || $jtype in {object array})
		}]
		if {$wants_json} {
			dict set args $arg [json extract $v]
		} else {
			dict set args $arg [json get $v]
		}
	}
	# Apply per-member transforms that compile_input registered (blob base64,
	# NaN/Infinity float, timestamp-as-epoch). At runtime these are emitted
	# as static lines in the op body; replicate them here so the harness can
	# exercise the same code path.
	foreach tfm [dict get $compiled transforms] {
		lassign $tfm kind var spec
		if {![dict exists $args $var]} continue
		set src [dict get $args $var]
		dict set args _tx_$var [switch -exact -- $kind {
			blob		{::aws::_tx_blob $src}
			float		{::aws::_tx_float $src}
			ts_epoch	{::aws::_tx_ts_epoch $src}
			ts_iso		{::aws::_tx_ts_iso $src}
			ts_rfc822	{::aws::_tx_ts_rfc822 $src}
			rewrite		{::aws::_tx_rewrite $src $spec}
		}]
	}
	set body	[json template $t $args]
	# Strip null leaves — AWS rejects some nulls, and the test vectors expect
	# omitted absent members (not explicit nulls).
	set paths	{{}}
	while {[llength $paths]} {
		set paths	[lassign $paths thispath]
		switch -exact -- [json type $body {*}$thispath] {
			object {
				json foreach {k v} [json extract $body {*}$thispath] {
					if {[json exists $v]} {
						lappend paths	[list {*}$thispath $k]
					} else {
						json unset body {*}$thispath $k
					}
				}
			}
			array {
				for {set i [json length [json extract $body {*}$thispath]]} {$i >= 0} {incr i -1} {
					if {[json exists $body {*}$thispath $i]} {
						lappend paths	[list {*}$thispath $i]
					} else {
						json unset body {*}$thispath $i
					}
				}
			}
		}
	}
	return $body
}

#>>>
proc diff_json_body {actual expected} { #<<<
	# Compare two JSON bodies for semantic equality (keys in objects are unordered,
	# array element order is preserved). An empty or {} expected body means "no
	# meaningful body".
	# Both "no body" forms normalise to {} for this comparison.
	set exp_empty	[expr {$expected eq "" || $expected eq "\{\}"}]
	set act_empty	[expr {$actual eq "" || ($actual ne "" && [json valid $actual] && [json normalize $actual] eq "{}")}]
	if {$exp_empty && $act_empty} {return ""}
	if {$exp_empty} {return "expected no body, got $actual"}
	if {$act_empty} {return "expected $expected, got no body"}
	if {[json_equal $actual $expected]} {return ""}
	return "actual=[json normalize $actual] expected=[json normalize $expected]"
}

#>>>
proc json_equal {a b} { # Recursive equality that ignores object key order. <<<
	set ta [json type $a]
	set tb [json type $b]
	if {$ta ne $tb} {return 0}
	switch -exact -- $ta {
		object {
			set ka [lsort [json keys $a]]
			set kb [lsort [json keys $b]]
			if {$ka ne $kb} {return 0}
			foreach k $ka {
				if {![json_equal [json extract $a $k] [json extract $b $k]]} {return 0}
			}
			return 1
		}
		array {
			if {[json length $a] != [json length $b]} {return 0}
			for {set i 0} {$i < [json length $a]} {incr i} {
				if {![json_equal [json extract $a $i] [json extract $b $i]]} {return 0}
			}
			return 1
		}
		default {
			expr {[json normalize $a] eq [json normalize $b]}
		}
	}
}

#>>>
proc template_sub_kinds t { #<<<
	# Scan an rl_json template string for ~X:name substitutions and return a dict
	# {name X name X ...} where X is S, N, B, J, or T.
	set result	{}
	foreach {whole kind name} [regexp -all -inline {~([SNBJT]):([A-Za-z_][A-Za-z0-9_]*)} $t] {
		dict set result $name $kind
	}
	set result
}

#>>>
proc case_op_version {entry case} { # Extract Action name and apiVersion for a case. <<<
	set op_name	[json get $case given name]
	set apiVersion	[json get $entry metadata apiVersion]
	list $op_name $apiVersion
}

#>>>
proc diff_query_body {actual expected} { #<<<
	# Compare two URL-encoded bodies by unpacking them into dicts (order-
	# independent) then comparing. Key-value pairs are URL-decoded for comparison.
	# Returns "" on match, otherwise a diff description.
	set a [reuri::query get $actual]
	set e [reuri::query get $expected]
	if {$a eq $e} return
	# Produce a diff
	set only_a {}; set only_e {}; set mismatch {}
	foreach k [lsort -unique [concat [dict keys $a] [dict keys $e]]] {
		if {![dict exists $e $k]} {lappend only_a $k=[dict get $a $k]; continue}
		if {![dict exists $a $k]} {lappend only_e $k=[dict get $e $k]; continue}
		if {[dict get $a $k] ne [dict get $e $k]} {
			lappend mismatch "$k: [dict get $a $k] vs [dict get $e $k]"
		}
	}
	set parts {}
	if {[llength $only_a]} {lappend parts "only-in-actual: [join $only_a {, }]"}
	if {[llength $only_e]} {lappend parts "only-in-expected: [join $only_e {, }]"}
	if {[llength $mismatch]} {lappend parts "mismatch: [join $mismatch {, }]"}
	join $parts {; }
}

#>>>
proc assemble_body_for_protocol {compiled entry case op_name apiVersion} { #<<<
	# Build the uncompressed request body for any protocol (dispatches to the
	# per-protocol assemblers) — used by the request-compression cases.
	switch -exact -- [json get $entry metadata protocol] {
		query - ec2 {
			assemble_query_body $compiled $op_name $apiVersion [json get -default {} $case params]
		}
		json - rest-json - json_1_0 {
			assemble_json_body $compiled [json extract -default {{}} $case params]
		}
		rest-xml {
			set xml_input	[if {[json exists $case given input]} {
				aws::build::compile_xml_input \
					-shapes	[json extract [synth_service $entry] shapes] \
					-input	[json extract $case given input]
			}]
			assemble_xml_body $compiled $entry $case $xml_input
		}
	}
}

#>>>
proc assemble_headers {compiled pdict} { #<<<
	# Build the request headers from the compiled header_map and the case params,
	# matching what _service_req does for header-located members (used to seed an
	# existing Content-Encoding before compression).
	set headers	{}
	foreach {hdr arg} [dict get $compiled header_map] {
		if {[string index $hdr end] eq "*"} continue ;# headers-map prefix
		json foreach {k v} $pdict {
			if {[aws::from_camel $k] eq $arg} {
				lappend headers $hdr [json get $v]
				break
			}
		}
	}
	set headers
}

#>>>
proc verify_compression {compiled case body encodings} { #<<<
	# Verify the requestCompression behaviour: gzip the assembled body, then check
	# the resulting Content-Encoding header against the vector and that the body
	# round-trips through gunzip. Returns "match" or errors.
	set pdict		[json extract -default {{}} $case params]
	set headers		[assemble_headers $compiled $pdict]
	set original	$body
	::aws::_compress_request body headers $encodings
	set errs	{}
	set exp_ce	[json get -default {} $case serialized headers Content-Encoding]
	set got_ce	[if {[dict exists $headers Content-Encoding]} {dict get $headers Content-Encoding}]
	if {$got_ce ne $exp_ce} {
		lappend errs "Content-Encoding: got ($got_ce) want ($exp_ce)"
	}
	if {[zlib gunzip $body] ne $original} {
		lappend errs "body did not round-trip through gunzip"
	}
	if {[llength $errs]} {error [join $errs {; }]}
	return match
}

#>>>

# --- idempotency-token auto-fill ----------------------------------------
# The SDK fills an absent idempotencyToken member with a UUIDv4; the Smithy
# vectors mock the generator to the fixed value 00000000-0000-4000-8000-
# 000000000000 (see autofill_idempotency).

proc case_has_idempotency {entry case} { # True if the operation's input has a member with the idempotencyToken trait. <<<
	set ish	[json get -default {} $case given input shape]
	if {$ish eq "" || ![json exists $entry shapes $ish members]} {return 0}
	json foreach {mn md} [json extract $entry shapes $ish members] {
		if {[json get -default false $md idempotencyToken]} {return 1}
	}
	return 0
}

#>>>
proc autofill_idempotency {entry case} { #<<<
	# Return the case params with any absent idempotencyToken member filled in with
	# the fixed test UUID (mirrors _auto_idempotency_token, which the runtime runs
	# after parse_args).
	set pdict	[json extract -default {{}} $case params]
	set ish		[json get -default {} $case given input shape]
	if {$ish eq "" || ![json exists $entry shapes $ish members]} {return $pdict}
	json foreach {mn md} [json extract $entry shapes $ish members] {
		if {[json get -default false $md idempotencyToken] && ![json exists $pdict $mn]} {
			json set pdict $mn {"00000000-0000-4000-8000-000000000000"}
		}
	}
	set pdict
}

#>>>
proc assemble_uri {compiled entry case params} { #<<<
	# Build the request URI (path with {label} substitutions + query string) the
	# way _service_req / _aws_req would, from the compiled uri_map / query_map and
	# the (autofilled) params. For query/ec2 the params ride in the body, so only
	# the path is used.
	set uri	[json get $case given http requestUri]
	foreach {label arg} [dict get $compiled uri_map] {
		set val	""
		json foreach {k v} $params {
			if {[aws::from_camel $k] eq $arg} {set val [json get $v]; break}
		}
		set uri	[string map [list "{$label}" [reuri encode path $val] "{$label+}" $val] $uri]
	}
	if {[json get $entry metadata protocol] in {rest-json rest-xml}} {
		set qs	{}
		foreach {name arg spec} [dict get $compiled query_map] {
			json foreach {k v} $params {
				if {[aws::from_camel $k] eq $arg} {
					lappend qs $name=[reuri encode query [json get $v]]
					break
				}
			}
		}
		if {[llength $qs]} {append uri ?[join $qs &]}
	}
	return $uri
}

#>>>
# Compare the assembled request body (for the given params) against the
# vector's serialized.body, dispatching on protocol. Returns "" on match.
proc check_body {compiled entry case op_name apiVersion params} { #<<<
	set exp_body	[json get -default {} $case serialized body]
	switch -exact -- [json get $entry metadata protocol] {
		query - ec2 {
			diff_query_body [assemble_query_body $compiled $op_name $apiVersion [json get $params]] $exp_body
		}
		json - rest-json - json_1_0 {
			# An operation with no input shape (empty template) has no body.
			if {[dict get $compiled template_obj] eq ""} {
				diff_json_body "" $exp_body
			} else {
				diff_json_body [assemble_json_body $compiled $params] $exp_body
			}
		}
		rest-xml {
			set xml_input	[if {[json exists $case given input]} {
				aws::build::compile_xml_input \
					-shapes	[json extract [synth_service $entry] shapes] \
					-input	[json extract $case given input]
			}]
			diff_xml_body [assemble_xml_body $compiled $entry $case $xml_input] $exp_body
		}
		default {return "unsupported protocol"}
	}
}
#>>>

# Verify an idempotency-token case: auto-fill the token, then check both the
# serialized body and the URI (the token lands in the body for query/ec2, in
# the query string for rest-json/rest-xml).
proc verify_idempotency {compiled entry case op_name apiVersion} { #<<<
	set params	[autofill_idempotency $entry $case]
	set diff	[check_body $compiled $entry $case $op_name $apiVersion $params]
	if {$diff ne ""} {error "body: $diff"}
	set uri		[assemble_uri $compiled $entry $case $params]
	set exp_uri	[json get -default / $case serialized uri]
	if {$uri ne $exp_uri} {error "uri: got ($uri) want ($exp_uri)"}
	return match
}
#>>>

# Verify an endpoint-hostPrefix (host-label) case: the labelled member also
# serializes normally (body), and the substituted hostPrefix prepends the host.
# We don't resolve the base host here, so we check the computed prefix is a
# prefix of the vector's expected host.
proc verify_host_label {compiled entry case op_name apiVersion} { #<<<
	set params	[if {[json exists $case params]} {json extract $case params} else {return -level 0 {{}}}]
	set diff	[check_body $compiled $entry $case $op_name $apiVersion $params]
	if {$diff ne ""} {error "body: $diff"}
	set hp		[json get $case given endpoint hostPrefix]
	set prefix	$hp
	foreach {- name} [regexp -all -inline {\{(\w+)\}} $hp] {
		set prefix	[string map [list \{$name\} [json get -default {} $params $name]] $prefix]
	}
	set exp_host	[json get $case serialized host]
	if {![string match $prefix* $exp_host]} {
		error "host: computed prefix ($prefix) is not a prefix of expected host ($exp_host)"
	}
	return match
}
#>>>

# rest-xml: assemble the request body the same way ::aws::_service_req does —
# build the body doc (template + transforms + null-strip for the no-payload
# case, or the raw payload member value for the payload-trait case), then walk
# it into XML via ::aws::_build_xml_body using the compiled xml_input.
proc assemble_xml_body {compiled entry case xml_input} { #<<<
	set payload	[dict get $compiled body]
	set pdict	[if {[json exists $case params]} {json extract $case params} else {return -level 0 {{}}}]
	if {$payload ne ""} {
		# payload trait: the body is the payload member's value.
		set match_camel	""
		json foreach {k _} $pdict {
			if {[aws::from_camel $k] eq $payload} {set match_camel $k; break}
		}
		if {$match_camel eq ""} {return ""}
		set pv	[json extract $pdict $match_camel]
		if {$xml_input in {{} {Body {} {}}}} {
			# Raw blob/string payload — body is the value verbatim.
			return [json get $pv]
		}
		# Structure payload: apply the member's rewriter (locationName renames /
		# nested transforms) the way _service_req walks the _tx_ value.
		foreach tfm [dict get $compiled transforms] {
			lassign $tfm kind var spec
			if {$kind eq "rewrite" && $var eq $payload} {
				set pv	[::aws::_tx_rewrite $pv $spec]
				break
			}
		}
		return [encoding convertfrom utf-8 [::aws::_build_xml_body $xml_input $pv]]
	}
	# No payload trait: assemble the full body doc then wrap.
	if {$xml_input in {{} {Body {} {}}}} {return ""}
	set bodydoc	[assemble_json_body $compiled $pdict]
	return [encoding convertfrom utf-8 [::aws::_build_xml_body $xml_input $bodydoc]]
}
#>>>

# Compare two XML request bodies structurally (element names, attributes, text,
# child order; whitespace between elements and attribute order ignored). "" on
# match, else a diff description.
proc diff_xml_body {actual expected} { #<<<
	set ae	[expr {[string trim $actual] eq ""}]
	set ee	[expr {[string trim $expected] eq ""}]
	if {$ae && $ee} {return ""}
	if {$ae}        {return "expected a body, got none; expected: $expected"}
	if {$ee}        {return "expected no body, got: $actual"}
	set ca	[xml_canon $actual]
	set ce	[xml_canon $expected]
	if {$ca eq $ce} {return ""}
	return "actual:   $ca\nexpected: $ce"
}
#>>>
proc xml_canon {xmlstr} { #<<<
	# Normalise by parsing, dropping the inter-element indentation whitespace
	# the vectors (and tdom's asXML) add, and re-serialising. Namespace
	# declarations and attributes round-trip faithfully through tdom, so two
	# semantically equal documents produce identical strings.
	set doc	[dom parse $xmlstr]
	try {
		_xml_strip_ws [$doc documentElement]
		[$doc documentElement] asXML -indent none
	} finally {
		$doc delete
	}
}
#>>>
proc _xml_strip_ws node { #<<<
	foreach c [$node childNodes] {
		switch -- [$c nodeType] {
			TEXT_NODE - CDATA_SECTION_NODE {
				if {[string trim [$c nodeValue]] eq ""} {$c delete}
			}
			ELEMENT_NODE {_xml_strip_ws $c}
		}
	}
}
#>>>

# ------------------------------------------------------------------
# Test driver

# Cases for SDK features not yet implemented. These are gated behind the
# `not_implemented` test constraint (always false) rather than silently
# skipped, so they stay visible in the run summary ("skipped by constraint")
# — the intent is to cover the full SDK surface, so each entry here is a TODO,
# not a deliberate omission. When a feature lands, delete its ids from this
# list and the vectors start exercising it.
tcltest::testConstraint not_implemented 0

set not_implemented_cases {
	# WIP: remaining real-dispatch input edges (binary/blob bodies, a few
	# host-with-path endpoint cases that the stub endpoint resolver does
	# not model, and capture edge cases). Removed as each is fixed.
	AllQueryStringTypes
	AwsJson10HostWithPath
	AwsJson11HostWithPath
	Ec2QueryHostWithPath
	HttpRequestLabelEscaping
	HttpRequestWithLabelsAndTimestampFormat
	InputAndOutputWithBooleanHeaders
	InputWithHeadersAndAllParams
	QueryHostWithPath
	RestJsonHostWithPath
	RestJsonHttpChecksumRequired
	RestJsonHttpRequestLabelEscaping
	RestJsonHttpRequestWithLabelsAndTimestampFormat
	RestJsonNullAndEmptyHeaders
	RestJsonTestPayloadBlob
	RestXmlZeroAndFalseQueryValues
	SDKAppendedGzipAfterProvidedEncoding_restJson1
	SDKAppendedGzipAfterProvidedEncoding_restXml
	SDKAppendsGzipAndIgnoresHttpProvidedEncoding_awsJson1_0
	SDKAppendsGzipAndIgnoresHttpProvidedEncoding_awsJson1_1
	SDKAppendsGzipAndIgnoresHttpProvidedEncoding_awsQuery
	SDKAppendsGzipAndIgnoresHttpProvidedEncoding_ec2Query
	SDKAppliedContentEncoding_awsJson1_0
	SDKAppliedContentEncoding_awsJson1_1
	SDKAppliedContentEncoding_awsQuery
	SDKAppliedContentEncoding_ec2Query
	SDKAppliedContentEncoding_restJson1
	SDKAppliedContentEncoding_restXml
	SimpleScalarProperties
}

# Output-vector cases gated separately (ids can collide with passing input
# cases, which must keep running).
set not_implemented_output_cases {
}

# Run all input cases from a protocol vector file.
# ------------------------------------------------------------------
# Real-dispatch harness
#
# Instead of reimplementing _service_req, we reify each vector entry's
# operations as genuine callable ops (via the same compile_op the build uses,
# or the rest-xml lazy compiler), stub the HTTP boundary (_aws_req) with
# rltest stub_commands, and drive `aws vec <op> <params>` through the real
# request-construction / response-decoding code.

# Fixed endpoint resolver for reified services (vectors don't assert on the
# host beyond hostPrefix, which prepends to it).
proc ::aws::vec_eir {region} { #<<<
	dict create hostname example.com protocols {https} region $region \
		signingRegion $region signatureVersions {v4} \
		credentialScope [dict create region $region] disableDoubleEncoding true
}
#>>>
# Reify a vector entry's operations as callable ops under ::aws::vec — eager
# protocols via compile_op, rest-xml via the lazy ensemble.
proc reify_service {entry} { #<<<
	set md		[json extract $entry metadata]
	set proto	[json get $md protocol]
	json set md service_name		vec
	json set md service_name_orig	vec
	set def	{{}}
	json set def metadata	$md
	json set def shapes		[json extract $entry shapes]
	json set def operations	{{}}
	json foreach case [json extract $entry cases] {
		set g	[json extract $case given]
		json set def operations [json get $g name] $g
	}
	catch {namespace delete ::aws::vec}
	if {$proto eq "rest-xml"} {
		namespace eval ::aws::vec {
			namespace export *
			namespace path {::parse_args ::rl_json ::aws ::aws::helpers}
			namespace ensemble create -prefixes no -unknown ::aws::_compile_rest-xml_op
			variable endpoint_cache {}
		}
		set ::aws::vec::service_def			$def
		set ::aws::vec::protocol			$proto
		set ::aws::vec::service_name_orig	vec
		set ::aws::vec::endpoint_params		{}
		set ::aws::vec::paginators			{{}}
		set ::aws::vec::responses			{}
		set ::aws::vec::exceptions			{}
		# rest-xml ops resolve the endpoint via the namespace's endpoint_rules
		# proc (not the ei var) — its result feeds the op's own ei lambda.
		proc ::aws::vec::endpoint_rules params {
			return {{"url":"https://example.com","properties":{"authSchemes":[{"name":"sigv4","signingName":"vec","signingRegion":"us-east-1","disableDoubleEncoding":false}]},"_":{"service":"vec","region":"us-east-1","credentialScope":{"region":"us-east-1"}}}}
		}
	} else {
		namespace eval ::aws::vec {
			namespace export *
			namespace ensemble create -prefixes no
			namespace path {::parse_args ::rl_json ::aws ::aws::helpers}
			variable endpoint_cache {}
		}
		set ::aws::vec::protocol		$proto
		set ::aws::vec::service_def		$def
		set ::aws::vec::endpoint_params	{}
		set ::aws::vec::paginators		{{}}
		set ::aws::vec::ei				::aws::vec_eir
		if {$proto in {query ec2} && [json exists $md apiVersion]} {
			set ::aws::vec::apiVersion	[json get $md apiVersion]
		}
		set responses {}; set exceptions {}
		json foreach {op opdef} [json extract $def operations] {
			set pt	[compile_op $def $op $opdef $proto {} responses exceptions]
			namespace eval ::aws::vec [aws::_reconstruct {} $pt]
		}
		if {[dict size $responses]} {set ::aws::vec::responses $responses}
	}
}
#>>>
# Build the `aws vec <op> …` arg list from a case's params, honouring the
# per-protocol input contract: query/ec2 take Tcl-native composite values,
# json/rest-xml take JSON fragments; booleans are flags (present iff true).
proc vec_build_args {entry case} { #<<<
	set proto	[json get $entry metadata protocol]
	set args	{-region us-east-1}
	if {![json exists $case params]} {return $args}
	set ish	[json get -default {} $case given input shape]
	json foreach {k v} [json extract $case params] {
		if {[json isnull $v]} continue
		set arg		-[aws from_camel $k]
		set mtype	{}
		if {$ish ne "" && [json exists $entry shapes $ish members $k]} {
			set mtype	[resolve_shape_type [json extract $entry shapes] [json get $entry shapes $ish members $k shape]]
		}
		switch -exact -- $mtype {
			boolean { if {[json get $v]} {lappend args $arg} }
			structure - union - list - map {
				lappend args $arg [if {$proto in {query ec2}} {json get $v} else {json extract $v}]
			}
			default { lappend args $arg [json get $v] }
		}
	}
	return $args
}
#>>>
# {serialized_key -> default} for top-level boolean input members, for the
# absent≡default-present leniency in body comparison.
proc vec_bool_defaults {entry case} { #<<<
	set ish	[json get -default {} $case given input shape]
	set out	{}
	if {$ish ne "" && [json exists $entry shapes $ish members]} {
		json foreach {mn md} [json extract $entry shapes $ish members] {
			if {[resolve_shape_type [json extract $entry shapes] [json get $md shape]] ne "boolean"} continue
			set def	[json get -default false $md default]
			if {[json exists $entry shapes [json get $md shape] default]} {
				set def	[json get $entry shapes [json get $md shape] default]
			}
			dict set out [json get -default $mn $md locationName] [expr {$def ? 1 : 0}]
		}
	}
	return $out
}
#>>>
# --- per-protocol body comparison (with boolean-default leniency) ---
proc vec_cmp_form {got exp booldefs} { #<<<
	# Parse "a=b&c=d" to a sorted list of {key decoded-value}, dropping any
	# boolean whose value matches its default (absent ≡ default-present).
	set norm	[list apply {{body booldefs} {
		set out {}
		foreach kv [split $body &] {
			if {$kv eq ""} continue
			lassign [split $kv =] k v
			set dv	[reuri decode $v]
			if {[dict exists $booldefs $k] && [expr {$dv ? 1 : 0}] == [dict get $booldefs $k]} continue
			lappend out [list $k $dv]
		}
		lsort $out
	}}]
	set g	[{*}$norm $got $booldefs]
	set e	[{*}$norm $exp $booldefs]
	if {$g eq $e} {return ""}
	return "form-body mismatch:\n  got $g\n  exp $e"
}
#>>>
proc vec_strip_bool_json {j booldefs} { #<<<
	if {[json type $j] ne "object"} {return $j}
	dict for {k def} $booldefs {
		if {[json exists $j $k] && [json type $j $k] eq "boolean" && [expr {[json get $j $k] ? 1 : 0}] == $def} {
			json unset j $k
		}
	}
	return $j
}
#>>>
proc vec_cmp_json {got exp booldefs} { #<<<
	if {$got eq ""} {set got {{}}}
	if {$exp eq ""} {set exp {{}}}
	if {![json valid $got] || ![json valid $exp]} {
		# raw (string/blob payload) — compare bytes
		if {$got eq $exp} {return ""}
		return "raw-body mismatch:\n  got ($got)\n  exp ($exp)"
	}
	set g	[vec_strip_bool_json $got $booldefs]
	set e	[vec_strip_bool_json $exp $booldefs]
	if {[json_equal $g $e]} {return ""}
	return "json-body mismatch:\n  got [json normalize $g]\n  exp [json normalize $e]"
}
#>>>
proc vec_cmp_xml {got exp booldefs} { #<<<
	if {$got eq "" && $exp eq ""} {return ""}
	# A blob/string payload body isn't XML; compare raw if either side isn't.
	if {![string match <* [string trimleft $got]] || ![string match <* [string trimleft $exp]]} {
		if {$got eq $exp} {return ""}
		return "raw-body mismatch:\n  got ($got)\n  exp ($exp)"
	}
	set strip	[list apply {{xml booldefs} {
		set doc	[dom parse $xml]
		set root	[$doc documentElement]
		dict for {k def} $booldefs {
			foreach n [$root selectNodes $k] {
				set t	[string trim [$n asText]]
				if {[expr {$t ? 1 : 0}] == $def} {$n delete}
			}
		}
		set out	[$root asXML]
		$doc delete
		set out
	}}]
	if {[xml_canon [{*}$strip $got $booldefs]] eq [xml_canon [{*}$strip $exp $booldefs]]} {return ""}
	return "xml-body mismatch:\n  got [xml_canon $got]\n  exp [xml_canon $exp]"
}
#>>>
# Compare a captured request against the case's expected serialization.
proc vec_check_input {entry case cap} { #<<<
	set proto		[json get $entry metadata protocol]
	set ser			[json extract $case serialized]
	set booldefs	[vec_bool_defaults $entry $case]

	set xm	[json get -default POST $ser method]
	if {[dict get $cap method] ne $xm} {return "method got [dict get $cap method] exp $xm"}

	set gb	[dict get $cap body]
	set xb	[json get -default {} $ser body]
	set d	[switch -exact -- $proto {
		query - ec2					{vec_cmp_form $gb $xb $booldefs}
		rest-xml					{vec_cmp_xml  $gb $xb $booldefs}
		json - json_1_0 - rest-json	{vec_cmp_json $gb $xb $booldefs}
		default						{return "unsupported protocol $proto"}
	}]
	if {$d ne ""} {return $d}

	# URI: path + (query params). Compare decode-normalized.
	set gu	[dict get $cap path]
	if {[llength [dict get $cap params]]} {
		append gu [expr {[string first ? $gu] >= 0 ? "&" : "?"}] [join [lmap {k v} [dict get $cap params] {format %s=%s $k [reuri encode awssig $v]}] &]
	}
	set xu	[json get -default / $ser uri]
	set unorm [list apply {u {
		lassign [split $u ?] p q
		set qp [lsort [lmap kv [split $q &] {lassign [split $kv =] k v; list $k [reuri decode $v]}]]
		list $p $qp
	}}]
	if {[{*}$unorm $gu] ne [{*}$unorm $xu]} {return "uri got ($gu) exp ($xu)"}

	# Modeled headers (Content-Type compared charset-insensitively).
	set gh	[dict get $cap headers]
	json foreach {hk hv} [json extract -default {{}} $ser headers] {
		set want	[json get $hv]
		if {[string equal -nocase $hk Content-Type]} {
			set got		[lindex [split [dict get $cap content_type] {;}] 0]
			set want	[lindex [split $want {;}] 0]
		} else {
			# HTTP header names are case-insensitive; ours are lower-cased.
			set got	{}
			dict for {k v} $gh {
				if {[string equal -nocase $k $hk]} {set got $v; break}
			}
		}
		# A boolean header explicitly set to its default is indistinguishable
		# from unset under parse_args, so absent ≡ default-present.
		if {$got eq "" && [dict exists $booldefs $hk] && $want eq [expr {[dict get $booldefs $hk] ? "true" : "false"}]} continue
		if {$got ne $want} {return "header $hk got ($got) exp ($want)"}
	}
	return ""
}
#>>>
proc run_input_file {path} { #<<<
	global not_implemented_cases
	set entries		[chantricks::readfile $path]
	set protocol	[file rootname [file tail $path]]
	rltest stub_commands {
		::aws::helpers::_aws_req {method endpoint path args} {
			set a	[dict create {*}$args]
			set ::vec_cap	[dict create method $method endpoint $endpoint path $path \
				body [dict getdef $a -body {}] headers [dict getdef $a -headers {}] \
				params [dict getdef $a -params {}] content_type [dict getdef $a -content_type {}]]
			throw {AWS VecCapture x} captured
		}
		::aws::helpers::_uuid4 {} {return 00000000-0000-4000-8000-000000000000}
	} {
		json foreach entry $entries {
			reify_service $entry
			json foreach case [json extract $entry cases] {
				set case_id		[json get $case id]
				set constraints	[if {$case_id in $not_implemented_cases} {list not_implemented}]
				test protocol-input-$protocol-$case_id [json get -default $case_id $entry description] -constraints $constraints -body {
					set op		[aws from_camel [json get $case given name]]
					set args	[vec_build_args $entry $case]
					set ::vec_cap	{}
					set rc	[catch {aws vec $op {*}$args} e o]
					if {!($rc == 1 && [lrange [dict get $o -errorcode] 0 1] eq {AWS VecCapture})} {
						error "expected request capture, got rc=$rc ([dict get $o -errorcode]): $e"
					}
					set diff	[vec_check_input $entry $case $::vec_cap]
					if {$diff ne ""} {error $diff}
					return match
				} -cleanup {unset -nocomplain op args rc e o diff} -result match
			}
		}
	}
}
#>>>

# ------------------------------------------------------------------
# Output (response decoding) driver

# Build a service_def carrying the case's operation, for the response decoders.
proc synth_output_def {entry case} { #<<<
	set sd	[synth_service $entry]
	json set sd operations [json get $case given name] [json extract $case given]
	set sd
}

#>>>
# Decode a case's canned HTTP response into a result JSON, using the same
# runtime machinery _service_req drives. Returns the decoded JSON.
proc decode_output {entry case} { #<<<
	set sd		[synth_output_def $entry $case]
	set op		[json get $case given name]
	set hdrs	{}
	json foreach {k v} [json extract -default {{}} $case response headers] {
		dict set hdrs [string tolower $k] [list [json get $v]]
	}
	# An operation with no output shape decodes to an empty result.
	if {![json exists $case given output]} {return {{}}}
	::aws::resp_cx instvar cx \
		-status		[json get -default 200 $case response status_code] \
		-headers	$hdrs \
		-body		[json get -default {} $case response body]
	set res	[switch -exact -- [json get $entry metadata protocol] {
		rest-xml {
			::aws::_handle_xml_resp $sd $op -cx $cx -payload pl
		}
		query - ec2 {
			# query/ec2 decode via the compiled fetchlist/template + _resp_xml.
			# query wraps the result in <OpResult> (real models carry it as
			# resultWrapper; Smithy vectors omit it, so default to <Op>Result);
			# ec2 has no result wrapper (the response root is the result).
			if {[json get -default {} $case response body] eq ""} {return {{}}}
			set fetchlist	{}
			set template	[aws::build::compile_xml_transforms \
				-shape		[json get $case given output shape] \
				-shapes		[json extract $sd shapes] \
				-fetchlist	fetchlist]
			set rw	[if {[json get $entry metadata protocol] eq "query"} {
				json get -default ${op}Result $case given output resultWrapper
			}]
			::aws::_resp_xml $rw $fetchlist $template [json get $case response body]
		}
		default {
			return -code error "output decoder not implemented for this protocol"
		}
	}]
	# The XML handler returns the payload member separately (via -payload);
	# merge it back so the result matches the vector's full structure.
	set outshape	[json extract $sd shapes [json get $case given output shape]]
	if {
		[json exists $outshape payload] &&
		[info exists pl] &&
		$pl ne "" &&
		[json get -default {} $case response body] ne ""
	} {
		set pm		[json get $outshape payload]
		set ptype	[json get $sd shapes [json get $outshape members $pm shape] type]
		# _build_resp_frag returns a JSON value for everything except a raw
		# blob payload, which comes back as bytes.
		json set res $pm [if {$ptype eq "blob"} {json string $pl} else {set pl}]
	}
	set res
}

#>>>
# Parse an ISO-8601 / RFC-822 timestamp string to (possibly fractional) epoch
# seconds, so a decoded wire timestamp can be compared against the vector's
# epoch result regardless of which representation we return.
proc ts_to_epoch {s} { #<<<
	# Already epoch seconds (unixTimestamp wire form).
	if {[string is double -strict $s]} {return $s}
	set frac	0
	if {[regexp {^(.*?)\.(\d+)(.*)$} $s -> head digits tz]} {
		set frac	[expr {double($digits) / pow(10, [string length $digits])}]
		set s		$head$tz
	}
	# Normalise Z -> +0000 and +01:00 -> +0100 for %z.
	set s	[string map {Z +0000} [regsub {([+-]\d\d):(\d\d)$} $s {\1\2}]]
	foreach fmt {%Y-%m-%dT%H:%M:%S%z {%a, %d %b %Y %H:%M:%S %Z}} {
		if {![catch {clock scan $s -format $fmt} e]} {
			return [expr {$e + $frac}]
		}
	}
	return -code error "cannot parse timestamp: $s"
}
#>>>

# Recursively drop null object members (the query/ec2 _assemble_json decoder
# emits null for absent members; the vectors omit them).
proc strip_nulls {j} { #<<<
	switch -exact -- [json type $j] {
		object {
			set out	{{}}
			json foreach {k v} $j {
				if {[json type $v] eq "null"} continue
				json set out $k [strip_nulls $v]
			}
			return $out
		}
		array {
			set out	{[]}
			json foreach v $j {json set out end+1 [strip_nulls $v]}
			return $out
		}
		default {return $j}
	}
}
#>>>

# Like json_equal, but tolerates a timestamp returned as a wire string vs the
# vector's epoch number (compares the parsed instant). Also treats numbers
# numerically so 1.0 == 1.
proc result_equal {a b} { #<<<
	set ta	[json type $a]
	set tb	[json type $b]
	if {$ta ne $tb} {
		if {"string" in [list $ta $tb] && "number" in [list $ta $tb]} {
			set s	[json get [expr {$ta eq "string" ? $a : $b}]]
			set n	[json get [expr {$ta eq "number" ? $a : $b}]]
			return [expr {![catch {ts_to_epoch $s} e] && $e == $n}]
		}
		return 0
	}
	switch -exact -- $ta {
		object {
			if {[lsort [json keys $a]] ne [lsort [json keys $b]]} {return 0}
			foreach k [json keys $a] {
				if {![result_equal [json extract $a $k] [json extract $b $k]]} {return 0}
			}
			return 1
		}
		array {
			if {[json length $a] != [json length $b]} {return 0}
			for {set i 0} {$i < [json length $a]} {incr i} {
				if {![result_equal [json extract $a $i] [json extract $b $i]]} {return 0}
			}
			return 1
		}
		number	{expr {[json get $a] == [json get $b]}}
		default	{expr {[json normalize $a] eq [json normalize $b]}}
	}
}
#>>>

# Run all (success-result) output cases from a protocol vector file.
proc run_output_file {path} { #<<<
	global not_implemented_output_cases
	set entries		[chantricks::readfile $path]
	set protocol	[file rootname [file tail $path]]
	json foreach entry $entries {
		set desc	[json get $entry description]
		json foreach case [json extract $entry cases] {
			# Error-response decoding is covered separately; skip here.
			if {![json exists $case result]} continue
			set case_id		[json get $case id]
			set constraints	[if {$case_id in $not_implemented_output_cases} {list not_implemented}]
			set name		protocol-output-$protocol-$case_id
			test $name $desc -constraints $constraints -body {
				set got	[strip_nulls [decode_output $entry $case]]
				set exp	[json extract $case result]
				if {![result_equal $got $exp]} {
					error "got [json normalize $got]\nexp [json normalize $exp]"
				}
				return "match"
			} -cleanup {unset -nocomplain got exp} -result match
		}
	}
}
#>>>

# Kick off
set protocol_dir	[file join [file dirname [info script]] .. botocore tests unit protocols]
if {[file isdirectory $protocol_dir]} {
	foreach proto {query ec2 json json_1_0 rest-json rest-xml} {
		set path	[file join $protocol_dir input $proto.json]
		if {[file exists $path]} {
			run_input_file $path
		}
	}
	foreach proto {query ec2 rest-xml} {
		set path	[file join $protocol_dir output $proto.json]
		if {[file exists $path]} {
			run_output_file $path
		}
	}
}

::tcltest::cleanupTests
return

# vim: ft=tcl foldmethod=marker foldmarker=<<<,>>> ts=4 shiftwidth=4
