if {[lsearch [namespace children] ::tcltest] == -1} {
	package require tcltest
	namespace import ::tcltest::*
}

tcltest::loadTestedCommands
package require aws 2
package require tomcrypt 0.9.2

# Tests for the SigV4-A signing path: KDF scalar derivation, ECDSA
# signature produced against the derived public key, canonical-request
# specifics (credential scope without region, X-Amz-Region-Set header
# included and signed, AWS4-ECDSA-P256-SHA256 algorithm name).
#
# ECDSA uses a random k, so signature hex isn't reproducible. We
# verify round-trip: sign, then check the signature is valid DER and
# verifies against the public key derived from the same KDF scalar.
# Canonical request and string-to-sign are deterministic and checked
# exactly.

namespace eval ::test_sigv4a {
	# Well-known AWS sigv4 test credentials
	variable aws_id  AKIDEXAMPLE
	variable secret  wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY

	# Override get_creds so sigv4a doesn't need real credentials.
	# Rename-shuffle rather than `info body` + `proc` reconstruction:
	# the latter chokes on comments / unbalanced braces that are
	# syntactically fine in the original body.
	proc setup {} {
		variable aws_id
		variable secret
		if {[info commands ::aws::helpers::_get_creds_orig] eq ""} {
			rename ::aws::helpers::get_creds ::aws::helpers::_get_creds_orig
		}
		proc ::aws::helpers::get_creds {} [list return [list \
			access_key [set aws_id] \
			secret     [set secret]]]
	}
	proc cleanup {} {
		if {[info commands ::aws::helpers::_get_creds_orig] ne ""} {
			rename ::aws::helpers::get_creds ""
			rename ::aws::helpers::_get_creds_orig ::aws::helpers::get_creds
		}
	}
}

set sigv4a_setup   ::test_sigv4a::setup
set sigv4a_cleanup ::test_sigv4a::cleanup

# Derive scalar tests <<<

test derive_sigv4a_scalar-1.1 {KDF produces 32-byte output} -body { #<<<
	set s [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]
	string length $s
} -cleanup {unset -nocomplain s} -result 32
#>>>
test derive_sigv4a_scalar-1.2 {KDF is deterministic for the same inputs} -body { #<<<
	set a [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]
	set b [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]
	expr {$a eq $b}
} -cleanup {unset -nocomplain a b} -result 1
#>>>
test derive_sigv4a_scalar-1.3 {KDF depends on access key id} -body { #<<<
	set a [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]
	set b [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY OTHER-ID]
	expr {$a ne $b}
} -cleanup {unset -nocomplain a b} -result 1
#>>>
test derive_sigv4a_scalar-1.4 {KDF depends on secret} -body { #<<<
	set a [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]
	set b [::aws::helpers::_derive_sigv4a_scalar \
		differentsecret AKIDEXAMPLE]
	expr {$a ne $b}
} -cleanup {unset -nocomplain a b} -result 1
#>>>
test derive_sigv4a_scalar-1.5 {derived scalar is in [1, n-1] for well-known creds} -body { #<<<
	# n for secp256r1
	set n [scan ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551 %llx]
	set s [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]
	set d [scan [binary encode hex $s] %llx]
	expr {$d >= 1 && $d < $n}
} -cleanup {unset -nocomplain n s d} -result 1
#>>>
test derive_sigv4a_scalar-1.6 {scalar is ecc_import_raw_private-loadable} -body { #<<<
	# End-to-end: derive, load, extract pubkey, round-trip sign/verify.
	set s    [::aws::helpers::_derive_sigv4a_scalar \
		wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]
	set priv [tomcrypt::ecc_import_raw_private secp256r1 $s]
	set pub  [tomcrypt::ecc_extract_pubkey $priv]
	set h    [tomcrypt::hash sha256 "hello"]
	set sig  [tomcrypt::ecc_sign $priv $h]
	tomcrypt::ecc_verify $sig $h $pub
} -cleanup {unset -nocomplain s priv pub h sig} -result 1
#>>>

# Derive scalar tests >>>

# Full-signing tests <<<

test sigv4a-1.1 {algorithm name is AWS4-ECDSA-P256-SHA256} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-out_url url -out_headers hdrs -out_sts sts -out_authz authz
	string match "AWS4-ECDSA-P256-SHA256 *" $authz
} -cleanup {
	unset -nocomplain date url hdrs sts authz
	$sigv4a_cleanup
} -result 1
#>>>
test sigv4a-1.2 {credential scope omits region} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date -region us-west-2 \
		-out_url url -out_headers hdrs -out_sts sts -out_authz authz
	# Expected: $date_stamp/$service/aws4_request — nothing between service and aws4_request
	regexp {Credential=AKIDEXAMPLE/([^,]+),} $authz -> scope
	set scope
} -cleanup {
	unset -nocomplain date url hdrs sts authz scope
	$sigv4a_cleanup
} -result {20150830/example/aws4_request}
#>>>
test sigv4a-1.3 {X-Amz-Region-Set header is always present and signed} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-out_url url -out_headers hdrs -out_sts sts -out_authz authz
	regexp {SignedHeaders=([^,]+)} $authz -> signed
	list \
		region_set_present	[dict exists $hdrs X-Amz-Region-Set] \
		signed				[expr {"x-amz-region-set" in [split $signed ";"]}]
} -cleanup {
	unset -nocomplain date url hdrs sts authz signed
	$sigv4a_cleanup
} -result {region_set_present 1 signed 1}
#>>>
test sigv4a-1.4 {default region_set is "*"} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-out_url url -out_headers hdrs -out_sts sts
	dict get $hdrs X-Amz-Region-Set
} -cleanup {
	unset -nocomplain date url hdrs sts
	$sigv4a_cleanup
} -result *
#>>>
test sigv4a-1.5 {explicit region_set list is joined with commas} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-region_set {us-east-1 us-west-2 eu-west-1} \
		-out_url url -out_headers hdrs -out_sts sts
	dict get $hdrs X-Amz-Region-Set
} -cleanup {
	unset -nocomplain date url hdrs sts
	$sigv4a_cleanup
} -result {us-east-1,us-west-2,eu-west-1}
#>>>
test sigv4a-1.6 {string-to-sign format is correct} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-out_url url -out_headers hdrs -out_sts sts
	# Four lines: algo, amz-datetime, credential_scope, hex hash
	set lines [split $sts \n]
	list \
		n_lines		[llength $lines] \
		algo		[lindex $lines 0] \
		datetime	[lindex $lines 1] \
		scope		[lindex $lines 2] \
		hash_len	[string length [lindex $lines 3]]
} -cleanup {
	unset -nocomplain date url hdrs sts lines
	$sigv4a_cleanup
} -result {n_lines 4 algo AWS4-ECDSA-P256-SHA256 datetime 20150830T123600Z scope 20150830/example/aws4_request hash_len 64}
#>>>
test sigv4a-1.7 {produced signature verifies against derived public key} -setup $sigv4a_setup -body { #<<<
	# ECDSA uses random k so the signature isn't bit-reproducible.
	# Verify by re-computing the public key from the KDF-derived scalar
	# and checking ecc_verify on the signature over SHA-256(sts).
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-out_url url -out_headers hdrs -out_sts sts -out_authz authz

	regexp {Signature=([0-9a-f]+)} $authz -> sig_hex
	set sig_bytes [binary decode hex $sig_hex]
	set sts_hash  [tomcrypt::hash sha256 [encoding convertto utf-8 $sts]]

	set priv [tomcrypt::ecc_import_raw_private secp256r1 \
		[::aws::helpers::_derive_sigv4a_scalar \
			wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY AKIDEXAMPLE]]
	set pub  [tomcrypt::ecc_extract_pubkey $priv]
	tomcrypt::ecc_verify $sig_bytes $sts_hash $pub
} -cleanup {
	unset -nocomplain date url hdrs sts authz sig_hex sig_bytes sts_hash priv pub
	$sigv4a_cleanup
} -result 1
#>>>
test sigv4a-1.8 {different runs produce different signatures (random k)} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	set first  ""
	set second ""
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-out_url url -out_headers hdrs -out_sts sts -out_authz first
	::aws::helpers::sigv4a \
		-method GET -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-out_url url -out_headers hdrs -out_sts sts -out_authz second
	expr {$first ne $second}
} -cleanup {
	unset -nocomplain date first second url hdrs sts
	$sigv4a_cleanup
} -result 1
#>>>
test sigv4a-1.9 {missing -sig_service throws} -setup $sigv4a_setup -body { #<<<
	set rc [catch {
		::aws::helpers::sigv4a \
			-method GET -endpoint example.amazonaws.com -path / \
			-out_url url -out_headers hdrs -out_sts sts
	} res ei]
	list rc $rc code [lrange [dict get $ei -errorcode] 0 2]
} -cleanup {
	unset -nocomplain rc res ei url hdrs sts
	$sigv4a_cleanup
} -result {rc 1 code {AWS SIGV4A MISSING_SIG_SERVICE}}
#>>>
test sigv4a-1.10 {body hash ends up as payload hash in canonical request} -setup $sigv4a_setup -body { #<<<
	set date [clock scan 20150830T123600Z -format %Y%m%dT%H%M%SZ -timezone :UTC]
	set body "hello world"
	::aws::helpers::sigv4a \
		-method POST -endpoint example.amazonaws.com \
		-sig_service example -path / -date $date \
		-body $body -content_type text/plain \
		-out_url url -out_headers hdrs -out_sts sts -out_creq creq

	set expected_hash [binary encode hex [tomcrypt::hash sha256 $body]]
	# Last line of creq is the hashed payload
	set creq_hash [lindex [split $creq \n] end]
	expr {$creq_hash eq $expected_hash}
} -cleanup {
	unset -nocomplain date body url hdrs sts creq expected_hash creq_hash
	$sigv4a_cleanup
} -result 1
#>>>

# Full-signing tests >>>

# Integration with _req <<<

test sigv4a-req-1.1 {_req accepts -version v4a} -setup $sigv4a_setup -body { #<<<
	# Verify -version's enum includes the new values by inspecting the
	# proc body. regexp keeps the pattern in a quoted string so the
	# literal braces don't confuse Tcl's brace-counting word parser.
	regexp -- {-enum \{v4 v2 s3 s3v4 v4a s3v4a\}} [info body ::aws::helpers::_req]
} -cleanup {
	$sigv4a_cleanup
} -result 1
#>>>

# Integration with _req >>>

::tcltest::cleanupTests
return

