source [file join [file dirname [file normalize [info script]]] common.tcl]

# Asserts the account has at least one queue — account-specific state, so
# gated on rl_aws_account rather than bare aws_creds.
test sqs-list_queues-1.1 {} -constraints rl_aws_account -body { #<<<
	expr {[json length [aws sqs list_queues] QueueUrls] > 0}
} -result 1
#>>>

# cleanup
::tcltest::cleanupTests
return

# vim: ft=tcl foldmethod=marker foldmarker=<<<,>>> ts=4 shiftwidth=4
