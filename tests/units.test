# Rule engine helpers <<<
test _a-1.1 {truthy scalar result assigns and returns 1} -body { #<<<
	array set p {}
	::aws::_fn::_a myvar return -level 0 hello
	list $p(myvar)
} -cleanup {unset -nocomplain p} -result hello
#>>>
test _a-1.2 {empty string result fails the condition} -body { #<<<
	array set p {}
	set r [::aws::_fn::_a myvar return -level 0 ""]
	list $r [info exists p(myvar)]
} -cleanup {unset -nocomplain p r} -result {0 0}
#>>>
test _a-1.3 {json null result fails} -body { #<<<
	array set p {}
	set r [::aws::_fn::_a myvar return -level 0 null]
	list $r [info exists p(myvar)]
} -cleanup {unset -nocomplain p r} -result {0 0}
#>>>
test _a-1.4 {"false" string result fails} -body { #<<<
	array set p {}
	set r [::aws::_fn::_a myvar return -level 0 false]
	list $r [info exists p(myvar)]
} -cleanup {unset -nocomplain p r} -result {0 0}
#>>>
test _a-1.5 {erroring body fails the condition} -body { #<<<
	array set p {}
	set r [::aws::_fn::_a myvar error "nope"]
	list $r [info exists p(myvar)]
} -cleanup {unset -nocomplain p r} -result {0 0}
#>>>
test _a-1.6 {json object result assigns} -body { #<<<
	array set p {}
	::aws::_fn::_a myvar return -level 0 {{"a":1}}
	set p(myvar)
} -cleanup {unset -nocomplain p} -result {{"a":1}}
#>>>

# Rule engine helpers >>>
# Query flattening <<<
test compile_query_spec-1.1 {scalar string} -body { #<<<
	set shapes {{"S": {"type":"string"}}}
	::aws::build::compile_query_spec $shapes S ec2
} -cleanup {unset -nocomplain shapes} -result {}
#>>>
test compile_query_spec-1.2 {list of scalars, ec2 flattened} -body { #<<<
	set shapes {{"L":{"type":"list","member":{"shape":"S"}},"S":{"type":"string"}}}
	::aws::build::compile_query_spec $shapes L ec2
} -cleanup {unset -nocomplain shapes} -result {list member 1 {}}
#>>>
test compile_query_spec-1.3 {list of scalars, query non-flattened} -body { #<<<
	set shapes {{"L":{"type":"list","member":{"shape":"S"}},"S":{"type":"string"}}}
	::aws::build::compile_query_spec $shapes L query
} -cleanup {unset -nocomplain shapes} -result {list member 0 {}}
#>>>
test compile_query_spec-1.4 {struct with ec2 capitalization} -body { #<<<
	set shapes {
		{
			"F": {"type":"structure","members":{
				"name": {"shape":"S","locationName":"name"},
				"values": {"shape":"S","locationName":"Value"}
			}},
			"S": {"type":"string"}
		}
	}
	::aws::build::compile_query_spec $shapes F ec2
} -cleanup {unset -nocomplain shapes} -result {struct {name Name {} values Value {}}}
#>>>

test _flatten_query_param-1.1 {scalar} -body { #<<<
	set q {}
	::aws::_flatten_query_param q foo bar {}
	set q
} -cleanup {unset -nocomplain q} -result {foo bar}
#>>>
test _flatten_query_param-1.2 {flat list} -body { #<<<
	set q {}
	::aws::_flatten_query_param q Name {alpha beta gamma} {list member 1 {}}
	set q
} -cleanup {unset -nocomplain q} -result {Name.1 alpha Name.2 beta Name.3 gamma}
#>>>
test _flatten_query_param-1.3 {non-flat list uses .member. infix} -body { #<<<
	set q {}
	::aws::_flatten_query_param q Name {a b} {list member 0 {}}
	set q
} -cleanup {unset -nocomplain q} -result {Name.member.1 a Name.member.2 b}
#>>>
test _flatten_query_param-1.4 {list of structs} -body { #<<<
	set q {}
	set spec {list member 1 {struct {name Name {} value Value {}}}}
	::aws::_flatten_query_param q Filter \
		{{name foo value bar} {name baz value qux}} $spec
	set q
} -cleanup {unset -nocomplain q spec} -result {Filter.1.Name foo Filter.1.Value bar Filter.2.Name baz Filter.2.Value qux}
#>>>
test _flatten_query_param-1.5 {list of structs with list member (filter with multiple values)} -body { #<<<
	set q {}
	set spec {list member 1 {struct {name Name {} values Value {list member 1 {}}}}}
	::aws::_flatten_query_param q Filter \
		{{name foo values {v1 v2 v3}}} $spec
	set q
} -cleanup {unset -nocomplain q spec} -result {Filter.1.Name foo Filter.1.Value.1 v1 Filter.1.Value.2 v2 Filter.1.Value.3 v3}
#>>>

# Query flattening >>>
# Error response parsing <<<
# _aws_error expects a fake "$h" object responding to body / code / headers
proc make_mock_h {body_val {code_val 400} {headers_val {}}} { #<<<
	set n [incr ::mock_count]
	set ns ::mock_h_$n
	namespace eval $ns [list variable _body $body_val]
	namespace eval $ns [list variable _code $code_val]
	namespace eval $ns [list variable _headers $headers_val]
	namespace eval $ns {
		proc body {} {variable _body; return $_body}
		proc code {} {variable _code; return $_code}
		proc headers {} {variable _headers; return $_headers}
		namespace export body code headers
		namespace ensemble create
	}
	return $ns
}
#>>>

set mock_cleanup {namespace delete $h; unset -nocomplain h}
test _aws_error-json-1.1 {JSON error with code/message} -setup { #<<<
	set h [make_mock_h {{"code":"ValidationException","message":"bad param"}} 400 \
		{content-type application/x-amz-json-1.1 x-amzn-requestid req-123}]
} -body {
	::aws::helpers::_aws_error $h "" ""
} -cleanup $mock_cleanup \
  -returnCodes error -errorCode {AWS ValidationException req-123 {}} -result {bad param}
#>>>
test _aws_error-json-1.2 {JSON error with __type (sigv4 style)} -setup { #<<<
	set h [make_mock_h {{"__type":"ResourceNotFoundException","message":"not found"}} 404 \
		{x-amzn-requestid req-456}]
} -body {
	::aws::helpers::_aws_error $h "" ""
} -cleanup $mock_cleanup \
  -returnCodes error -errorCode {AWS ResourceNotFoundException req-456 {}} -result {not found}
#>>>
test _aws_error-json-1.3 {JSON error with x-amzn-errortype header} -setup { #<<<
	set h [make_mock_h {{"message":"something went wrong"}} 400 \
		{x-amzn-errortype ThrottlingException x-amzn-requestid req-789}]
} -body {
	::aws::helpers::_aws_error $h "" ""
} -cleanup $mock_cleanup \
  -returnCodes error -errorCode {AWS ThrottlingException req-789 {}} -result {something went wrong}
#>>>

test _aws_error-xml-1.1 {rest-xml / query style Error element} -setup { #<<<
	set h [make_mock_h {<?xml version="1.0"?>
<Error>
	<Code>NoSuchKey</Code>
	<Message>The specified key does not exist.</Message>
	<Resource>/bucket/key</Resource>
	<RequestId>ABC123</RequestId>
</Error>} 404 {}]
} -body {
	::aws::helpers::_aws_error $h "" ""
} -cleanup $mock_cleanup \
  -returnCodes error -match glob -errorCode {AWS NoSuchKey ABC123 /bucket/key *} \
  -result {AWS: The specified key does not exist.}
#>>>
test _aws_error-xml-1.2 {ec2 Response/Errors/Error wrapper} -setup { #<<<
	set h [make_mock_h {<?xml version="1.0"?>
<Response>
	<Errors>
		<Error>
			<Code>InvalidInstanceID.Malformed</Code>
			<Message>Invalid id: "abc"</Message>
		</Error>
	</Errors>
	<RequestID>req-xyz</RequestID>
</Response>} 400 {}]
} -body {
	::aws::helpers::_aws_error $h "" ""
} -cleanup $mock_cleanup \
  -returnCodes error -match glob -errorCode {AWS InvalidInstanceID.Malformed req-xyz * *} \
  -result {AWS: Invalid id: "abc"}
#>>>
test _aws_error-1.3 {empty body uses status code} -setup { #<<<
	set h [make_mock_h "" 503 {}]
} -body {
	::aws::helpers::_aws_error $h "" ""
} -cleanup $mock_cleanup \
  -returnCodes error -errorCode {AWS 503} -result {AWS http code 503}
#>>>
# Error response parsing >>>

# Retry classifier + backoff + idempotency tokens <<<
test classify-1.1 {throttling error codes are retryable as throttle} -body { #<<<
	set kinds {}
	foreach code {
		Throttling ThrottlingException ThrottledException
		RequestThrottledException TooManyRequestsException
		ProvisionedThroughputExceededException RequestLimitExceeded
		SlowDown PriorRequestNotComplete EC2ThrottledException
		LimitExceededException BandwidthLimitExceeded
		TransactionInProgressException RequestThrottled
	} {
		lappend kinds [lindex [::aws::helpers::_classify_error \
			[dict create -errorcode [list AWS $code rq]]] 0]
	}
	lsort -unique $kinds
} -cleanup {unset -nocomplain kinds code} -result throttle
#>>>
test classify-1.2 {transient error codes are retryable as transient} -body { #<<<
	set kinds {}
	foreach code {
		InternalError InternalServerError InternalServerException
		ServiceUnavailable RequestTimeout RequestTimeoutException
		IDPCommunicationError InternalFailure BadGateway GatewayTimeout
	} {
		lappend kinds [lindex [::aws::helpers::_classify_error \
			[dict create -errorcode [list AWS $code rq]]] 0]
	}
	lsort -unique $kinds
} -cleanup {unset -nocomplain kinds code} -result transient
#>>>
test classify-1.3 {429 body-less status becomes throttle} -body { #<<<
	::aws::helpers::_classify_error [dict create -errorcode {AWS 429}]
} -result {throttle 429}
#>>>
test classify-1.4 {5xx body-less statuses are transient} -body { #<<<
	lmap c {500 502 503 504 509} {
		lindex [::aws::helpers::_classify_error \
			[dict create -errorcode [list AWS $c]]] 0
	}
} -cleanup {unset -nocomplain c} -result {transient transient transient transient transient}
#>>>
test classify-1.5 {RequestTimeTooSkewed becomes clockskew} -body { #<<<
	::aws::helpers::_classify_error [dict create -errorcode {AWS RequestTimeTooSkewed req}]
} -result {clockskew RequestTimeTooSkewed}
#>>>
test classify-1.6 {ValidationException is not retryable} -body { #<<<
	::aws::helpers::_classify_error [dict create -errorcode {AWS ValidationException req}]
} -result {none ValidationException}
#>>>
test classify-1.7 {non-AWS (socket/DNS/TLS) errors are transient} -body { #<<<
	lmap ec {
		{POSIX ECONNREFUSED {connection refused}}
		{POSIX ETIMEDOUT {timed out}}
		{NONE}
		{CHAN-ERROR write-error}
	} {
		lindex [::aws::helpers::_classify_error [dict create -errorcode $ec]] 0
	}
} -cleanup {unset -nocomplain ec} -result {transient transient transient transient}
#>>>

test backoff-1.1 {exponential with jitter — bounded by cap} -body { #<<<
	# 500 samples; none should exceed base*2^(attempt-1) capped at 20s
	foreach {attempt max_expect_ms} {1 500 2 1000 3 2000 4 4000 5 8000 8 20000} {
		for {set i 0} {$i < 200} {incr i} {
			set v [::aws::helpers::_backoff_ms $attempt]
			if {$v < 0 || $v > $max_expect_ms} {
				return "attempt=$attempt delay=${v}ms exceeds bound ${max_expect_ms}"
			}
		}
	}
	return ok
} -cleanup {unset -nocomplain attempt max_expect_ms i v} -result ok
#>>>
test backoff-1.2 {cap dominates at high attempts} -body { #<<<
	# attempt 20 — 0.5*2^19 = 262144s, should cap at 20000ms
	set max 0
	for {set i 0} {$i < 300} {incr i} {
		set v [::aws::helpers::_backoff_ms 20]
		if {$v > $max} {set max $v}
	}
	expr {$max <= 20000}
} -cleanup {unset -nocomplain max i v} -result 1
#>>>

test retry_after-1.1 {integer seconds} -body { #<<<
	::aws::helpers::_retry_after_ms {retry-after 7}
} -result 7000
#>>>
test retry_after-1.2 {missing header returns empty} -body { #<<<
	::aws::helpers::_retry_after_ms {content-type foo}
} -result {}
#>>>
test retry_after-1.3 {bogus value returns empty} -body { #<<<
	::aws::helpers::_retry_after_ms {retry-after garbage}
} -result {}
#>>>
test retry_after-1.4 {negative integer returns empty (no retry earlier than now)} -body { #<<<
	::aws::helpers::_retry_after_ms {retry-after -5}
} -result {}
#>>>
test retry_after-1.5 {HTTP-date 5s in the future} -body { #<<<
	set when [clock format [expr {[clock seconds] + 5}] \
		-format "%a, %d %b %Y %H:%M:%S GMT" -timezone :UTC]
	set v [::aws::helpers::_retry_after_ms [list retry-after $when]]
	# clock arithmetic can slip a second either way
	expr {$v >= 3000 && $v <= 6000}
} -cleanup {unset -nocomplain when v} -result 1
#>>>

test uuid4-1.1 {format matches RFC 4122 v4} -body { #<<<
	set u [::aws::helpers::_uuid4]
	regexp {^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$} $u
} -cleanup {unset -nocomplain u} -result 1
#>>>
test uuid4-1.2 {uniqueness over 1000 draws} -body { #<<<
	set s {}
	for {set i 0} {$i < 1000} {incr i} {lappend s [::aws::helpers::_uuid4]}
	expr {[llength [lsort -unique $s]] == 1000}
} -cleanup {unset -nocomplain s i} -result 1
#>>>

test auto_token-1.1 {auto-fills missing token} -body { #<<<
	apply {{} {
		# x not set — auto_idempotency_token should fill it
		::aws::_auto_idempotency_token x
		set ::__tok_holder $x
	}}
	expr {[regexp {^[0-9a-f-]{36}$} $::__tok_holder]}
} -cleanup {unset -nocomplain ::__tok_holder} -result 1
#>>>
test auto_token-1.2 {preserves caller's value} -body { #<<<
	apply {{} {
		set tok fixed-value
		::aws::_auto_idempotency_token tok
		set ::__tok_holder $tok
	}}
	set ::__tok_holder
} -cleanup {unset -nocomplain ::__tok_holder} -result fixed-value
#>>>

test auto_token_injection-1.1 {ec2 RunInstances injects auto-token call} -setup { #<<<
	package require aws::ec2
} -body {
	string match "*_auto_idempotency_token client_token*" \
		[info body ::aws::ec2::run_instances]
} -result 1
#>>>
test auto_token_injection-1.2 {ec2 DescribeInstances (no token member) has no injection} -setup { #<<<
	package require aws::ec2
} -body {
	string match "*_auto_idempotency_token*" \
		[info body ::aws::ec2::describe_instances]
} -result 0
#>>>

test sleep_ms-1.1 {plain-script sleep blocks for ≥ requested ms without pumping events} -body { #<<<
	# If _sleep_ms accidentally vwait'd, the scheduled 'after 0' event
	# below would fire during the sleep, setting $fired. We want it
	# to stay 0 because the thread must block entirely. The after
	# handler's update comes in -cleanup so it can't leak either.
	set fired 0
	after 0 [list set fired 1]
	set t0 [clock milliseconds]
	::aws::helpers::_sleep_ms 120
	set elapsed [expr {[clock milliseconds] - $t0}]
	list fired_during_sleep $fired blocked [expr {$elapsed >= 100 && $elapsed < 500}]
} -cleanup {
	update
	unset -nocomplain fired t0 elapsed
} -result {fired_during_sleep 0 blocked 1}
#>>>
test sleep_ms-1.2 {coroutine-mode sleep yields (does not block the thread)} -body { #<<<
	# The coroutine's lifetime escapes -body (yields, resumes via
	# event loop), so we name it and clean it up explicitly.
	set started 0
	set done    0
	coroutine ::_sleep_ms_coro apply {{startedvar donevar} {
		upvar #0 $startedvar started $donevar done
		set started 1
		::aws::helpers::_sleep_ms 80
		set done 1
	}} started done
	set yielded_quickly $started
	set fuse [after 1000 [list set done timeout]]
	vwait done
	after cancel $fuse
	list yielded_quickly $yielded_quickly done $done
} -cleanup {
	unset -nocomplain started done yielded_quickly fuse
	if {[info commands ::_sleep_ms_coro] ne ""} {rename ::_sleep_ms_coro {}}
} -result {yielded_quickly 1 done 1}
#>>>

