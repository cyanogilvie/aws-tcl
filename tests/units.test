if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*
}

tcltest::loadTestedCommands
package require aws 2
package require aws::endpoints 2 ;# so aws.partition has its data
package require rl_json 0.17
interp alias {} json {} ::rl_json::json

# Rule-engine primitives <<<
test getAttr-1.1 {simple dict key} -body { #<<<
	::aws::_fn::getAttr {{"a":"x","b":"y"}} a
} -result x
#>>>
test getAttr-1.2 {missing dict key raises (caller is usually wrapped in _a)} -body { #<<<
	::aws::_fn::getAttr {{"a":"x"}} b
} -returnCodes error -match glob -result {*not found*}
#>>>
test getAttr-1.3 {json null input returns null} -body { #<<<
	::aws::_fn::getAttr null a
} -result null
#>>>
test getAttr-1.4 {empty input returns null} -body { #<<<
	::aws::_fn::getAttr "" a
} -result null
#>>>
test getAttr-2.1 {named index into JSON array} -body { #<<<
	::aws::_fn::getAttr {{"x":["a","b","c"]}} {x[1]}
} -result b
#>>>
test getAttr-2.2 {out-of-range array index returns empty} -body { #<<<
	::aws::_fn::getAttr {{"x":["a","b"]}} {x[5]}
} -result {}
#>>>
test getAttr-2.3 {bare index into Tcl list (stringArray param)} -body { #<<<
	::aws::_fn::getAttr {arn1 arn2 arn3} {[0]}
} -result arn1
#>>>
test getAttr-2.4 {bare index out of range returns empty} -body { #<<<
	::aws::_fn::getAttr {arn1 arn2} {[5]}
} -result {}
#>>>

test isValidHostLabel-1.1 {simple label ok} -body { #<<<
	::aws::_fn::isValidHostLabel us-east-1 0
} -result 1
#>>>
test isValidHostLabel-1.2 {space in label rejected} -body { #<<<
	::aws::_fn::isValidHostLabel {us-east 1} 0
} -result 0
#>>>
test isValidHostLabel-1.3 {underscore rejected} -body { #<<<
	::aws::_fn::isValidHostLabel us_east_1 0
} -result 0
#>>>
test isValidHostLabel-1.4 {dot rejected when allowdots=0} -body { #<<<
	::aws::_fn::isValidHostLabel foo.bar 0
} -result 0
#>>>
test isValidHostLabel-1.5 {dot accepted when allowdots=1} -body { #<<<
	::aws::_fn::isValidHostLabel foo.bar 1
} -result 1
#>>>

test substring-1.1 {forward slice} -body { #<<<
	::aws::_fn::substring hello 1 4 0
} -result ell
#>>>
test substring-1.2 {reverse slice: last N chars} -body { #<<<
	# substring(str, 0, 6, true) on "mybucket--use1-az1--x-s3" -> "--x-s3"
	::aws::_fn::substring mybucket--use1-az1--x-s3 0 6 1
} -result --x-s3
#>>>
test substring-1.3 {start >= stop returns null} -body { #<<<
	::aws::_fn::substring hello 3 3 0
} -result null
#>>>
test substring-1.4 {stop > length returns null} -body { #<<<
	::aws::_fn::substring hi 0 10 0
} -result null
#>>>
test substring-1.5 {non-ascii returns null} -body { #<<<
	::aws::_fn::substring "foo\u306fbar" 0 3 0
} -result null
#>>>

test uriEncode-1.1 {unreserved characters preserved} -body { #<<<
	::aws::_fn::uriEncode abcXYZ0-9._~-
} -result abcXYZ0-9._~-
#>>>
test uriEncode-1.2 {sub-delims get encoded (per Smithy spec)} -body { #<<<
	::aws::_fn::uriEncode bucket!
} -result bucket%21
#>>>
test uriEncode-1.3 {space gets encoded} -body { #<<<
	::aws::_fn::uriEncode "foo bar"
} -result foo%20bar
#>>>
test uriEncode-1.4 {slash gets encoded} -body { #<<<
	::aws::_fn::uriEncode foo/bar
} -result foo%2Fbar
#>>>

test parseURL-1.1 {basic https URL} -body { #<<<
	set r [::aws::_fn::parseURL https://example.com/path]
	list [json get $r scheme] [json get $r authority] [json get $r path]
} -cleanup {unset -nocomplain r} -result {https example.com /path}
#>>>
test parseURL-1.2 {http URL accepted} -body { #<<<
	json get [::aws::_fn::parseURL http://example.com/] scheme
} -result http
#>>>
test parseURL-1.3 {non-http(s) scheme rejected} -body { #<<<
	::aws::_fn::parseURL ftp://example.com/
} -returnCodes error -match glob -result {*scheme*}
#>>>
test parseURL-1.4 {URL with query rejected} -body { #<<<
	::aws::_fn::parseURL https://example.com/?foo=bar
} -returnCodes error -match glob -result {*query*}
#>>>
test parseURL-1.5 {non-http scheme rejected (fragment in abcde:// variant)} -body { #<<<
	::aws::_fn::parseURL abcde://nota#url
} -returnCodes error -match glob -result {*scheme*}
#>>>

test aws.isVirtualHostableS3Bucket-1.1 {basic bucket name ok} -body { #<<<
	::aws::_fn::aws.isVirtualHostableS3Bucket mybucket 0
} -result 1
#>>>
test aws.isVirtualHostableS3Bucket-1.2 {dots ok when allowed} -body { #<<<
	::aws::_fn::aws.isVirtualHostableS3Bucket my.bucket 1
} -result 1
#>>>
test aws.isVirtualHostableS3Bucket-1.3 {dots rejected when disallowed} -body { #<<<
	::aws::_fn::aws.isVirtualHostableS3Bucket my.bucket 0
} -result 0
#>>>
test aws.isVirtualHostableS3Bucket-1.4 {too short rejected} -body { #<<<
	::aws::_fn::aws.isVirtualHostableS3Bucket ab 0
} -result 0
#>>>

# Rule-engine primitives >>>
# ARN / partition <<<
test aws.parseArn-1.1 {standard accesspoint ARN} -body { #<<<
	set r [::aws::_fn::aws.parseArn arn:aws:s3:us-west-2:123456789012:accesspoint:myendpoint]
	list [json get $r partition] [json get $r service] [json get $r region] \
		[json get $r accountId] [json get $r resourceId 0] [json get $r resourceId 1]
} -cleanup {unset -nocomplain r} -result {aws s3 us-west-2 123456789012 accesspoint myendpoint}
#>>>
test aws.parseArn-1.2 {resource with slashes splits into resourceId} -body { #<<<
	set r [::aws::_fn::aws.parseArn arn:aws:s3-outposts:us-east-1:123456789012:outpost/op-0123/accesspoint/reports]
	json get $r resourceId
} -cleanup {unset -nocomplain r} -result {outpost op-0123 accesspoint reports}
#>>>
test aws.parseArn-1.3 {empty components between colons preserved} -body { #<<<
	set r [::aws::_fn::aws.parseArn arn:aws:s3:us-west-2:123456789012::myname]
	json get $r resourceId
} -cleanup {unset -nocomplain r} -result {{} myname}
#>>>
test aws.parseArn-1.4 {missing partition errors (botocore treats as null)} -body { #<<<
	::aws::_fn::aws.parseArn "arn::kinesis:us-west-2:123:stream/foo"
} -returnCodes error -match glob -result {*missing required component*}
#>>>
test aws.parseArn-1.5 {not an ARN errors} -body { #<<<
	::aws::_fn::aws.parseArn notanarn
} -returnCodes error -match glob -result {*Cannot parse arn*}
#>>>
test aws.parseArn-1.6 {too few colons errors} -body { #<<<
	::aws::_fn::aws.parseArn arn:aws:s3
} -returnCodes error -match glob -result {*Cannot parse arn*}
#>>>

test aws.partition-1.1 {matches a known region via regionRegex} -body { #<<<
	# us-east-1 matches the aws partition regex
	json get [::aws::_fn::aws.partition s3 us-east-1] name
} -result aws
#>>>
test aws.partition-1.2 {matches aws-global via partitions.json regions dict} -body { #<<<
	json get [::aws::_fn::aws.partition s3 aws-global] name
} -result aws
#>>>
test aws.partition-1.3 {falls back to aws partition for unknown region} -body { #<<<
	# Matches botocore: unknown region returns the default (aws) partition
	# rather than null, so subsequent rules (e.g. isValidHostLabel) run.
	json get [::aws::_fn::aws.partition s3 {made up region}] name
} -result aws
#>>>

